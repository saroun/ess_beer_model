   SL3.h=0.0056;
   SL3.idx = 8;
   addComponent("SL3");
	
/* -------------------------------------------------
End of components definition
---------------------------------------------------*/
/* 
 Set operation mode (adjusts choppers and slits according to the predefined values.
*/  
    setMode(mode, lambda, 8);

// adjust sample slit: input parameters override values from default modes:
	if (s3w>0) SL3.w=s3w;
	if (s3h>0) SL3.h=s3h;
	if (s3dist>0) SL3.dist=Lsample-s3dist-bp_dist; // s3dist is from the sample ...


/* Define monitor ranges, optimized for full beam at the sample  */
    double mgn=0.05; // margin for wavelength and time
	mwidth=0.06; // [m]
	mheight=0.06; // [m]
	mtof1=Lsample*(1.0/vmax-mgn*(1.0/vmin-1.0/vmin)); // minimum ToF [s]
	mtof2=Lsample*(1.0/vmin+mgn*(1.0/vmin-1.0/vmin))+(nframes-1)/14; // maximum ToF [s]
	// add pulse width, except of "monochromatic" setups
	if ((mtof2-mtof1) > 0.003) {
		mtof1=mtof1-tau/2;
		mtof2=mtof2+taumax;
	} else {
		mtof1=mtof1-tau/2;
		mtof2=mtof2+tau/2;
	};
	mdivx=3; // h-div in [deg]
	mdivy=3; // v-div in [deg]
	mlam1=Lmin-(Lmax-Lmin)*mgn;
	mlam2=Lmax+(Lmax-Lmin)*mgn;
	mlam1=fmax(0.0,mlam1);

/* Verobse reporting */	

	if (verbose==1) {
/* -------------------------------------------------
Automatically generated code - setup report
---------------------------------------------------*/

      /* Monolith section*/
      reportTGuideTA("NBOA", NBOA);
      reportTGuideTA("BBG", BBG);


      /* Bunker section*/
      reportTGuideMC("GSW", GSW);
      reportTGuide("GCA1", GCA1);
      reportTCDisc("PSC1", PSC1);
      reportTGuide("GCA2", GCA2);
      reportTGuide("GCA3", GCA3);
      reportTCDisc("PSC2", PSC2);
      reportTGuide("GCA4", GCA4);
      reportTGuide("GCB", GCB);
      reportTCDisc("PSC3", PSC3);
      reportTGuide("GCC", GCC);
      reportTCDisc("FC1A", FC1A);
      reportTCDisc("FC1B", FC1B);
      reportTGuide("GCE", GCE);
      reportTCDisc("MCA", MCA);
      reportTCDisc("MCB", MCB);
      reportTGuide("GCF", GCF);
      reportTMDChopper("MCC", MCC);
      reportTGuide("GCG", GCG);
      reportTGuideEG("GE1", GE1);
      reportTGuideEG("GN1", GN1);
      reportTGuideEG("GN2", GN2);


      /* Transport section*/
      reportTGuide("GSH2", GSH2);
      reportTGuideEG("GE2A", GE2A);
      reportTGuideEG("GE2B", GE2B);
      reportTGuideEG("GT1", GT1);
      reportTCDisc("FC2A", FC2A);
      reportTCDisc("FC2B", FC2B);
      reportTGuideEG("GT2", GT2);


      /* Focusing section*/
      reportTGuideEG("GF1", GF1);
      reportTSlit("SL1", SL1);
      reportTGuideEG("GF2", GF2);
      reportTSlit("SL2", SL2);
      reportTGuideEG("GEX1", GEX1);
      reportTSlit("SL3", SL3);


/* -------------------------------------------------
End of setup report
---------------------------------------------------*/
		printf("\nPulse chopper at %g [m]\n",Lchopper);
	}
	printf("Time focusing: dist=%g, time=%g, width=%g\n",foc_dist, foc_time, foc_dt);

// define source flux distribution range for Monitor_nD	
	sprintf(options1,"user1 bins=200 limits=[-0.1,0.1]");
%} 

TRACE

COMPONENT Origin = Progress_bar()
  AT (0,0,0) ABSOLUTE

/* 
COMPONENT Source = MCPL_source( filename = "fW2.mcpl", Lmin=Lmin, Lmax=Lmax, smearing=1, verbose=0, I0=1.56e10)
AT(0,0,0) RELATIVE Origin
ROTATED (0 ,0 ,0) RELATIVE Origin 
EXTEND
%{ 
 SrcX=x;SrcY=y;SrcZ=z;
 srccount += 1;
 t -= t_offset;
%}
*/
 
COMPONENT Source = ESS_butterfly(sector="W",beamline=2,Lmin=Lmin,Lmax=Lmax,dist=0,target_index=+2,
 focus_xw=NBOA.w1+0.01, focus_yh=NBOA.h1+0.01, cold_frac=0.5, n_pulses=nframes, tmax_multiplier=taumax/tau, acc_power=5,
 tfocus_dist=foc_dist, tfocus_time=foc_time, tfocus_width=foc_dt)
AT (0, 0, 0) RELATIVE Origin 
EXTEND
%{ 
 SrcX=x;SrcY=y;SrcZ=z;
 srccount += 1;
 t -= t_offset;
%}


// Define beam axis at the insert front window, hereafter used as a reference position     
COMPONENT BPArm = Arm( )
  AT (bp_x0+bp_angle*DEG2RAD*bp_dist, 0, bp_dist) RELATIVE Origin
  ROTATED (0, bp_angle, 0) RELATIVE Origin
  
/* ------------------------------------------------------------
Automatically generated code - beamline components
---------------------------------------------------------------*/

/*--------------------------------------------------
Monolith section
--------------------------------------------------*/

/* NBOA: monolith insert*/
COMPONENT cNBOA = Guide_tapering(
	option = "file=prof_NBOA.txt",
	l = NBOA.L, w1=0, h1=0, linw=0, loutw=0, linh=0, louth=0,
	alphax = m_alpha, alphay = m_alpha, Qcx = m_Qc, Qcy = m_Qc, W = m_W,
	mx = NBOA.mx, my = NBOA.my, segno = NBOA.nseg
)
AT (NBOA.shift, 0, NBOA.dist) RELATIVE BPArm
ROTATED (0, NBOA.angle, 0) RELATIVE BPArm

/* monNBOA: */
COMPONENT monNBOA = L_monitor(filename="monNBOA.dat", xwidth = 0.1, yheight = 0.1, restore_neutron = 1,
	nL = 80, Lmin = 0.2, Lmax = 8.2)
AT (0, 0, NBOA.dist + NBOA.L + 0.001) RELATIVE BPArm

/* BBG: bridge beam guide*/
COMPONENT cBBG = Guide_tapering(
	option = "file=prof_BBG.txt",
	l = BBG.L, w1=0, h1=0, linw=0, loutw=0, linh=0, louth=0,
	alphax = m_alpha, alphay = m_alpha, Qcx = m_Qc, Qcy = m_Qc, W = m_W,
	mx = BBG.mx, my = BBG.my, segno = BBG.nseg
)
AT (BBG.shift, 0, BBG.dist) RELATIVE BPArm
ROTATED (0, BBG.angle, 0) RELATIVE BPArm

/* monBBG: */
COMPONENT monBBG = Monitor(xwidth = 0.1, yheight = 0.1, restore_neutron = 1)
AT (0, 0, BBG.dist + BBG.L + 0.001) RELATIVE BPArm

/*--------------------------------------------------
Bunker section
--------------------------------------------------*/

/* GSW: bi-spectral switch, adjustable angle, movable on/off the beam*/
COMPONENT cGSW = Guide_multichannel(
	l = GSW.L,w1 = GSW.w1, h1 = GSW.h1, w2 = GSW.w2, h2 = GSW.h2, 
	alphax = m_alpha, alphay = m_alpha, Qcx = m_Qc, Qcy = m_Qc, W = m_W, dlam = GSW.dlam,
	mx = GSW.mx, my = GSW.my, nslit = GSW.nseg+1, mater = "Si"
)
AT (GSW.shift, 0, GSW.dist) RELATIVE BPArm
ROTATED (0, GSW.angle, 0) RELATIVE BPArm

/* monGSW: */
COMPONENT monGSW = Monitor(xwidth = 0.1, yheight = 0.1, restore_neutron = 1)
AT (0, 0, GSW.dist + GSW.L + 0.001) RELATIVE BPArm

/* GCA1: chopper guide element*/
COMPONENT cGCA1 = Guide_gravity(
	l = GCA1.L, w1 = GCA1.w1, h1 = GCA1.h1, w2 = GCA1.w2, h2 = GCA1.h2,
	alpha = m_alpha, Qc = m_Qc, W = m_W,
	 mleft = GCA1.mx, mright = GCA1.mx, mtop = GCA1.my, mbottom = GCA1.my
)
AT (0, 0, GCA1.dist) RELATIVE BPArm

/* PSC1: pulse shaping*/
COMPONENT cPSC1 = DiskChopper(
	theta_0 = PSC1.win, radius = PSC1.R, yheight = PSC1.h, nu = PSC1.nu,
	nslit = PSC1.ns, phase = PSC1.phase
)
AT (0, 0, PSC1.dist) RELATIVE BPArm
ROTATED (0, PSC1.flip*180, 0) RELATIVE BPArm

/* GCA2: chopper guide element*/
COMPONENT cGCA2 = Guide_gravity(
	l = GCA2.L, w1 = GCA2.w1, h1 = GCA2.h1, w2 = GCA2.w2, h2 = GCA2.h2,
	alpha = m_alpha, Qc = m_Qc, W = m_W,
	 mleft = GCA2.mx, mright = GCA2.mx, mtop = GCA2.my, mbottom = GCA2.my
)
AT (0, 0, GCA2.dist) RELATIVE BPArm

/* GCA3: chopper guide element*/
COMPONENT cGCA3 = Guide_gravity(
	l = GCA3.L, w1 = GCA3.w1, h1 = GCA3.h1, w2 = GCA3.w2, h2 = GCA3.h2,
	alpha = m_alpha, Qc = m_Qc, W = m_W,
	 mleft = GCA3.mx, mright = GCA3.mx, mtop = GCA3.my, mbottom = GCA3.my
)
AT (0, 0, GCA3.dist) RELATIVE BPArm

/* PSC2: pulse shaping, variable distance 6650 to 6850*/
COMPONENT cPSC2 = DiskChopper(
	theta_0 = PSC2.win, radius = PSC2.R, yheight = PSC2.h, nu = PSC2.nu,
	nslit = PSC2.ns, phase = PSC2.phase
)
AT (0, 0, PSC2.dist) RELATIVE BPArm
ROTATED (0, PSC2.flip*180, 0) RELATIVE BPArm

/* GCA4: chopper guide element*/
COMPONENT cGCA4 = Guide_gravity(
	l = GCA4.L, w1 = GCA4.w1, h1 = GCA4.h1, w2 = GCA4.w2, h2 = GCA4.h2,
	alpha = m_alpha, Qc = m_Qc, W = m_W,
	 mleft = GCA4.mx, mright = GCA4.mx, mtop = GCA4.my, mbottom = GCA4.my
)
AT (0, 0, GCA4.dist) RELATIVE BPArm

/* GCB: chopper guide element*/
COMPONENT cGCB = Guide_gravity(
	l = GCB.L, w1 = GCB.w1, h1 = GCB.h1, w2 = GCB.w2, h2 = GCB.h2,
