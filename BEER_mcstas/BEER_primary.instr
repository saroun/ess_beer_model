	 printf("majOff: [%g, %g, %g, %g]\n",majOff[0],majOff[1],majOff[2],majOff[3]);
	 printf("minOff: [%g, %g, %g, %g]\n",minOff[0],minOff[1],minOff[2],minOff[3]);
}


