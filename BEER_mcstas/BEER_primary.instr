AT (0, 0, GCE.dist + GCE.L + 0.001) RELATIVE BPArm

/* MCA: modulation*/
COMPONENT cMCA = DiskChopper(
	theta_0 = MCA.win, radius = MCA.R, yheight = MCA.h, nu = MCA.nu,
	nslit = MCA.ns, phase = MCA.phase
)
AT (0, 0, MCA.dist) RELATIVE BPArm
ROTATED (0, MCA.flip*180, 0) RELATIVE BPArm

/* MCB: modulation*/
COMPONENT cMCB = DiskChopper(
	theta_0 = MCB.win, radius = MCB.R, yheight = MCB.h, nu = MCB.nu,
	nslit = MCB.ns, phase = MCB.phase
)
AT (0, 0, MCB.dist) RELATIVE BPArm
ROTATED (0, MCB.flip*180, 0) RELATIVE BPArm

/* GCF: chopper guide element*/
COMPONENT cGCF = Guide_gravity(
	l = GCF.L, w1 = GCF.w1, h1 = GCF.h1, w2 = GCF.w2, h2 = GCF.h2,
	alpha = m_alpha, Qc = m_Qc, W = m_W,
	 mleft = GCF.mx, mright = GCF.mx, mtop = GCF.my, mbottom = GCF.my
)
AT (0, 0, GCF.dist) RELATIVE BPArm

/* monGCF: */
COMPONENT monGCF = Monitor(xwidth = 0.1, yheight = 0.1, restore_neutron = 1)
AT (0, 0, GCF.dist + GCF.L + 0.001) RELATIVE BPArm

/* MCC: modulation*/
COMPONENT cMCC = MultiDiskChopper(
	radius = MCC.R, delta_y = 0.5*MCC.h - MCC.R, nu = MCC.nu,
	nslits = MCC.ns, phase = MCC.phase, abs_out=0,
	slit_width = MCC.wins, slit_center = MCC.ctrs
)
AT (0, 0, MCC.dist) RELATIVE BPArm

/* GCG: chopper guide element*/
COMPONENT cGCG = Guide_gravity(
	l = GCG.L, w1 = GCG.w1, h1 = GCG.h1, w2 = GCG.w2, h2 = GCG.h2,
	alpha = m_alpha, Qc = m_Qc, W = m_W,
	 mleft = GCG.mx, mright = GCG.mx, mtop = GCG.my, mbottom = GCG.my
)
AT (0, 0, GCG.dist) RELATIVE BPArm

/* monGCG: */
COMPONENT monGCG = Monitor(xwidth = 0.1, yheight = 0.1, restore_neutron = 1)
AT (0, 0, GCG.dist + GCG.L + 0.001) RELATIVE BPArm

/* GE1: NOTE: bent & vertically expanding !*/
COMPONENT cGE1 = Elliptic_guide_gravity(
	l = GE1.L, xwidth = GE1.w1, yheight = GE1.h1,
	majorAxisxw=GE1.ah, minorAxisxw=GE1.bh, majorAxisyh=GE1.av, minorAxisyh=GE1.bv,
	majorAxisoffsetxw=GE1.ctr, majorAxisoffsetyh=GE1.ctr,
	mleft = GE1.mL, mright = GE1.mR, mtop = GE1.mT,  mbottom = GE1.mB,
	R0 = 0.99, Qc = m_Qc, alpha = m_alpha, W = m_W
)
AT (0, 0, GE1.dist) RELATIVE BPArm

/* GN1:  */
COMPONENT cGN1 = Elliptic_guide_gravity(
	l = GN1.L, xwidth = GN1.w1, yheight = GN1.h1,
	majorAxisxw=GN1.ah, minorAxisxw=GN1.bh, majorAxisyh=GN1.av, minorAxisyh=GN1.bv,
	majorAxisoffsetxw=GN1.ctr, majorAxisoffsetyh=GN1.ctr,
	mleft = GN1.mL, mright = GN1.mR, mtop = GN1.mT,  mbottom = GN1.mB,
	R0 = 0.99, Qc = m_Qc, alpha = m_alpha, W = m_W
)
AT (0, 0, GN1.dist) RELATIVE BPArm

/* GN2: bunker wall insert*/
COMPONENT cGN2 = Elliptic_guide_gravity(
	l = GN2.L, xwidth = GN2.w1, yheight = GN2.h1,
	majorAxisxw=GN2.ah, minorAxisxw=GN2.bh, majorAxisyh=GN2.av, minorAxisyh=GN2.bv,
	majorAxisoffsetxw=GN2.ctr, majorAxisoffsetyh=GN2.ctr,
	mleft = GN2.mL, mright = GN2.mR, mtop = GN2.mT,  mbottom = GN2.mB,
	R0 = 0.99, Qc = m_Qc, alpha = m_alpha, W = m_W
)
AT (0, 0, GN2.dist) RELATIVE BPArm

/* monGN2: */
COMPONENT monGN2 = L_monitor(filename="monGN2.dat", xwidth = 0.1, yheight = 0.1, restore_neutron = 1,
	nL = 80, Lmin = 0.2, Lmax = 8.2)
AT (0, 0, GN2.dist + GN2.L + 0.001) RELATIVE BPArm

/*--------------------------------------------------
Transport section
--------------------------------------------------*/

/* GSH2: shutter insert*/
COMPONENT cGSH2 = Guide_gravity(
	l = GSH2.L, w1 = GSH2.w1, h1 = GSH2.h1, w2 = GSH2.w2, h2 = GSH2.h2,
