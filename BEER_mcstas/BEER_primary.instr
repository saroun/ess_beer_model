/* FC1B: WFD*/
COMPONENT cFC1B = DiskChopper(
	theta_0 = FC1B.win, radius = FC1B.R, yheight = FC1B.h, nu = FC1B.nu,
	nslit = FC1B.ns, phase = FC1B.phase
)
AT (0, 0, FC1B.dist) RELATIVE BPArm
ROTATED (0, FC1B.flip*180, 0) RELATIVE BPArm

/* GCE: chopper guide element*/
COMPONENT cGCE = Guide_gravity(
	l = GCE.L, w1 = GCE.w1, h1 = GCE.h1, w2 = GCE.w2, h2 = GCE.h2,
	alpha = m_alpha, Qc = m_Qc, W = m_W,
