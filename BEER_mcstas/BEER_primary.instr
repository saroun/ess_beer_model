/* monGE2B: */
COMPONENT monGE2B = Monitor(xwidth = 0.1, yheight = 0.1, restore_neutron = 1)
AT (0, 0, GE2B.dist + GE2B.L + 0.001) RELATIVE BPArm

/* GT1: transport guide before chopper*/
COMPONENT cGT1 = Elliptic_guide_gravity(
	l = GT1.L, xwidth = GT1.w1, yheight = GT1.h1,
	majorAxisxw=GT1.ah, minorAxisxw=GT1.bh, majorAxisyh=GT1.av, minorAxisyh=GT1.bv,
