COMPONENT cSL1 = Slit(xwidth = SL1.w, yheight = SL1.h)
AT (0, 0, SL1.dist) RELATIVE BPArm

/* GF2: L/R mirror only 0 .. 2500 mm, then absorbing*/
COMPONENT cGF2 = Elliptic_guide_gravity(
	l = GF2.L, xwidth = GF2.w1, yheight = GF2.h1,
	majorAxisxw=GF2.ah, minorAxisxw=GF2.bh, majorAxisyh=GF2.av, minorAxisyh=GF2.bv,
	majorAxisoffsetxw=GF2.ctr, majorAxisoffsetyh=GF2.ctr,
	mleft = GF2.mL, mright = GF2.mR, mtop = GF2.mT,  mbottom = GF2.mB,
	R0 = 0.99, Qc = m_Qc, alpha = m_alpha, W = m_W
)
AT (0, 0, GF2.dist) RELATIVE BPArm

/* monGF2: */
COMPONENT monGF2 = Monitor(xwidth = 0.1, yheight = 0.1, restore_neutron = 1)
AT (0, 0, GF2.dist + GF2.L + 0.001) RELATIVE BPArm

/* SL2: Adjustable diaphragm*/
COMPONENT cSL2 = Slit(xwidth = SL2.w, yheight = SL2.h)
AT (0, 0, SL2.dist) RELATIVE BPArm

/* GEX1: Focusing guide on exchanger*/
COMPONENT cGEX1 = Elliptic_guide_gravity(
	l = GEX1.L, xwidth = GEX1.w1, yheight = GEX1.h1,
	majorAxisxw=GEX1.ah, minorAxisxw=GEX1.bh, majorAxisyh=GEX1.av, minorAxisyh=GEX1.bv,
	majorAxisoffsetxw=GEX1.ctr, majorAxisoffsetyh=GEX1.ctr,
	mleft = GEX1.mL, mright = GEX1.mR, mtop = GEX1.mT,  mbottom = GEX1.mB,
	R0 = 0.99, Qc = m_Qc, alpha = m_alpha, W = m_W
)
WHEN (GF3On = 1) AT (0, 0, GEX1.dist) RELATIVE BPArm

/* monGEX1: */
COMPONENT monGEX1 = Monitor(xwidth = 0.1, yheight = 0.1, restore_neutron = 1)
AT (0, 0, GEX1.dist + GEX1.L + 0.001) RELATIVE BPArm

/* SL3: Sample input slit, adjustable distance and size*/
COMPONENT cSL3 = Slit(xwidth = SL3.w, yheight = SL3.h)
AT (0, 0, SL3.dist) RELATIVE BPArm

/* -------------------------------------------------
End of automatically generated code - beamline components
---------------------------------------------------*/
    
// Sample arm is a reference point for subsequent components
  COMPONENT Sample_axis = Arm( )
  AT (0,0,Lsample - bp_dist) RELATIVE BPArm
  
/* --------------------------------------------------------------------------------
End of primary beamline
-----------------------------------------------------------------------------------*/  


COMPONENT TWidth = Monitor_nD(filename = "TWidth.dat", xwidth=mwidth, yheight=mheight, user1=SrcX, username1="Source position / [m]", options=options1, restore_neutron=1)
  AT (0, 0, 0) RELATIVE Sample_axis

/* Monitor beam characteristics */

COMPONENT Lmon = L_monitor(
    nL = 160, filename = "Lmon.dat", xwidth = mwidth, yheight = mheight,
    Lmin = mlam1, Lmax = mlam2, restore_neutron = 1)
  AT (0, 0, 0) RELATIVE Sample_axis


COMPONENT TofMon = TOF_monitor(
    nt = 160, filename = "TofMon.dat", xwidth = mwidth, yheight = mheight,
    tmin = mtof1*1e6, tmax = mtof2*1e6, restore_neutron = 1)
  AT (0, 0, 0) RELATIVE Sample_axis


COMPONENT XMon = PSDlin_monitor(
    nx = 100, filename = "XMon.dat", xwidth = mwidth,
    yheight = mheight, restore_neutron = 1)
  AT (0, 0, 0) RELATIVE Sample_axis

COMPONENT YMon = PSDlin_monitor(
    nx = 100, filename = "YMon.dat", xwidth = mheight,
    yheight = mwidth, restore_neutron = 1)
  AT (0, 0, 0) RELATIVE Sample_axis
  ROTATED (0, 0, 90) RELATIVE Sample_axis  

COMPONENT HDivMon =Hdiv_monitor(
    nh = 100, filename = "HDivMon.dat", xwidth = mwidth, yheight = mheight, 
	h_maxdiv = 0.5*mdivx, restore_neutron = 1)
  AT (0, 0, 0) RELATIVE Sample_axis
  
 COMPONENT VDivMon = Hdiv_monitor(
    nh = 100, filename = "VDivMon.dat", xwidth = mwidth, yheight = mheight, 
	h_maxdiv = 0.5*mdivy, restore_neutron = 1)
  AT (0, 0, 0) RELATIVE Sample_axis
  ROTATED (0, 0, 90) RELATIVE Sample_axis  
  
COMPONENT DivMon = Divergence_monitor(
    nh = 100, nv = 100, filename = "DivMon.dat", xwidth = mwidth,
    yheight = mheight, maxdiv_h = 0.5*mdivx, maxdiv_v = 0.5*mdivy,
    restore_neutron = 1)
  AT (0, 0, 0) RELATIVE Sample_axis

  COMPONENT XYMon = PSD_monitor(
    nx = 100, ny = 100, filename = "XYMon.dat", xwidth = mwidth,
    yheight = mheight, restore_neutron = 1)
  AT (0, 0, 0) RELATIVE Sample_axis

 COMPONENT HDivPos = DivPos_monitor(
    nh = 100, ndiv = 100, filename = "HDivPos.dat", xwidth = mwidth,
    yheight = mheight, maxdiv_h = 0.5*mdivx, restore_neutron = 1)
  AT (0, 0, 0) RELATIVE Sample_axis

COMPONENT VDivPos = DivPos_monitor(
    nh = 100, ndiv = 100, filename = "VDivPos.dat", xwidth = mheight,
    yheight = mwidth, maxdiv_h = 0.5*mdivy, restore_neutron = 1)
  AT (0, 0, 0) RELATIVE Sample_axis	
  ROTATED (0, 0, 90) RELATIVE Sample_axis
	
COMPONENT TofLam = TOFLambda_monitor(
    nL = 512, nt = 512, tmin = mtof1*1e6, tmax = mtof2*1e6,
    filename = "TofLam.dat", xwidth = mwidth, yheight = 0.1, Lmin = mlam1,
    Lmax = mlam2, restore_neutron = 1)
  AT (0, 0, 0) RELATIVE Sample_axis
  
COMPONENT BSTPMon = PSD_monitor(
    nx = 100, ny = 100, filename = "BSTPMon.dat", xwidth = 0.5,
    yheight = 0.5, restore_neutron = 1)
  AT (0, 0, 8.3) RELATIVE Sample_axis
	   
FINALLY
%{

%}

/* The END token marks the instrument definition end */ 
END












