)
AT (0, 0, GCC.dist) RELATIVE BPArm

/* FC1A: WFD*/
COMPONENT cFC1A = DiskChopper(
	theta_0 = FC1A.win, radius = FC1A.R, yheight = FC1A.h, nu = FC1A.nu,
