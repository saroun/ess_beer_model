Focusing section
--------------------------------------------------*/

/* GF1:  */
COMPONENT cGF1 = Elliptic_guide_gravity(
	l = GF1.L, xwidth = GF1.w1, yheight = GF1.h1,
	majorAxisxw=GF1.ah, minorAxisxw=GF1.bh, majorAxisyh=GF1.av, minorAxisyh=GF1.bv,
