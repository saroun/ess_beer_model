		F.dist+bp_dist, F.w1, F.h1, F.w2, F.h2, F.L, F.dist+F.L+bp_dist);   
	};
	
	void reportTCDisc(char* name, TCDisc C) {
		printf("%s: dist=%g, win=%g, nu=%g, phase=%g\n", name,
			 C.dist+bp_dist, C.win, C.nu, C.phase);   
	};
	
	void reportTMDChopper(char* name, TMDChopper C) {
		printf("%s: dist=%g, nu=%g, phase=%g, wins=%s, ctrs=%s\n", name,
			 C.dist+bp_dist, C.nu, C.phase, C.wins, C.ctrs);   
	};

%}


INITIALIZE
%{  
dbgn=0;
	printf("BEER McStas file generated by %s on %s\n","@SOURCE","@DATE");
	printf("Wavelength range [A]: %g, %g \n",Lmin,Lmax);
// slope of supermirror reflectivity 	
	m_alpha = (1.0-R_m3)/(m_Qc*2);
// h/m_n 
	double hovm = K2V*2*PI;
// mean velocity for phase setting
    double v0 = hovm/lambda; 
	double vmax = hovm/Lmin;
    double vmin = hovm/Lmax;
// calculate theta and d-range 
    double thmin, thmax;
	double kz;
	// range pf Bragg angles
	if (tth-0.5*det_ah > 0.1) {
		thmin = 0.5*(tth-0.5*det_ah)*DEG2RAD;
	} else {
		thmin = 0.0;
	}
	if ((tth+0.5*det_ah) < 89.0) {
		kz = cos((tth+0.5*det_ah)*DEG2RAD);
		if (kz > 0) {
			thmax = 0.5*acos(cos(0.5*det_av*DEG2RAD)*kz);
		} else {
			thmax = 0.5*acos(kz);
		}
	} else {
		thmax = 0.499*PI;
	}
	
	// range of dhkl
	d_min = 0.5*Lmin/sin(thmax);
	if (thmin>0) {
		d_max = 0.5*Lmax/sin(thmin);
	} else {
		d_max = 10;
	}
	printf("Bragg angle span [deg]: %g, %g \n", thmin/DEG2RAD, thmax/DEG2RAD);
	printf("dhkl span [A]: %g, %g \n", d_min, d_max);
	
// clear source counter	
	srccount = 0;	

/*  START OF INSTRUMENT GEOMETRY */	 

/* -------------------------------------------------
Automatically generated code - ellipses definition
---------------------------------------------------*/	
/* ellipses: minor axis, major axis, distance to the ellipse center */
@ELLIPSES
/* -------------------------------------------------
End of ellipses definition
---------------------------------------------------*/

/* -------------------------------------------------
Automatically generated code - components definition
---------------------------------------------------*/
@INIT_PRIMARY	
/* -------------------------------------------------
End of components definition
---------------------------------------------------*/
/* 
 Set operation mode (adjusts choppers and slits according to the predefined values.
*/  
    setMode(mode, lambda, 8);

// adjust sample slit: input parameters override values from default modes:
	if (s3w>0) SL3.w=s3w;
	if (s3h>0) SL3.h=s3h;
	if (s3dist>0) SL3.dist=Lsample-s3dist-bp_dist; // s3dist is from the sample ...


/* Define monitor ranges, optimized for full beam at the sample  */
    double mgn=0.05; // margin for wavelength and time
	mwidth=0.06; // [m]
	mheight=0.06; // [m]
	mtof1=Lsample*(1.0/vmax-mgn*(1.0/vmin-1.0/vmin)); // minimum ToF [s]
	mtof2=Lsample*(1.0/vmin+mgn*(1.0/vmin-1.0/vmin))+(nframes-1)/14; // maximum ToF [s]
	// add pulse width, except of "monochromatic" setups
	if ((mtof2-mtof1) > 0.003) {
		mtof1=mtof1-tau/2;
		mtof2=mtof2+taumax;
	} else {
		mtof1=mtof1-tau/2;
		mtof2=mtof2+tau/2;
	};
	mdivx=3; // h-div in [deg]
	mdivy=3; // v-div in [deg]
	mlam1=Lmin-(Lmax-Lmin)*mgn;
	mlam2=Lmax+(Lmax-Lmin)*mgn;
	mlam1=fmax(0.0,mlam1);

/* Verobse reporting */	

	if (verbose==1) {
/* -------------------------------------------------
Automatically generated code - setup report
---------------------------------------------------*/
@REPORT
/* -------------------------------------------------
End of setup report
---------------------------------------------------*/
		printf("\nPulse chopper at %g [m]\n",Lchopper);
	}
	printf("Time focusing: dist=%g, time=%g, width=%g\n",foc_dist, foc_time, foc_dt);

// define source flux distribution range for Monitor_nD	
	sprintf(options1,"user1 bins=200 limits=[-0.1,0.1]");
%} 

