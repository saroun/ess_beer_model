/* Setting of operation modes 
m = operation mode
lam0 = nominal wavelength for chopper phase calculation
mcmult = 4, 8, or 16, for modulation: no. of windows per period
*/  
void setMode(int m, double lam0, int mcmult) {
	double v0 = K2V*2*PI/lam0; 
	
	// wavelength bandwidth corresponfding to 1 period
	double vT = (Lsample+Ldet)*14;
	double lamT = K2V*2*PI/vT;
	
	int mw = mod_wmodes[m];
	int mc = mod_cmodes[m];
	if (bs_on) {
		GSW.nseg=150;
	} else {
		GSW.nseg=0;
	}	
	
	// chopper frequencies
	PSC1.nu=mod_PSC1_nu[m];
	PSC2.nu=mod_PSC2_nu[m]; 
	PSC3.nu=mod_PSC3_nu[m]; 
	MCA.nu=mod_MCA_nu[m]; 
	MCB.nu=mod_MCB_nu[m];
	MCC.nu=mod_MCC_nu[m];
	FC1A.nu=mod_FC1A_nu[m];
	FC1B.nu=mod_FC1B_nu[m];
	FC2A.nu=mod_FC2A_nu[m];
	FC2B.nu=mod_FC2B_nu[m];
	
	// DiskChopper prints anoying messages if nu=0:
	if (! PSC1.nu) PSC1.nu = 1e-15;
	if (! PSC2.nu) PSC2.nu = 1e-15;
	if (! PSC3.nu) PSC3.nu = 1e-15;
	if (! MCA.nu) MCA.nu = 1e-15;
	if (! MCB.nu) MCB.nu = 1e-15;
	if (! MCC.nu) MCC.nu = 1e-15;
	if (! FC1A.nu) FC1A.nu = 1e-15;
	if (! FC1B.nu) FC1B.nu = 1e-15; 
	if (! FC2A.nu) FC2A.nu = 1e-15;
	if (! FC2B.nu) FC2B.nu = 1e-15;
	
	// slits and foc. guide setting
	SL1.w=mod_S1_w[m]*0.001;
	SL2.w=mod_S2_w[m]*0.001;
	SL3.w=mod_S3_w[m]*0.001;
	SL1.h=mod_S1_h[m]*0.001;
	SL2.h=mod_S2_h[m]*0.001;
	SL3.h=mod_S3_h[m]*0.001;
	GF3On=mod_GF3[m];

	// movable PSC2 with fixed GCA3 and GCA4
	double d1 = PSC2.dist - GCA3.dist;
	double d2 = PSC2.dist - GCA4.dist;
	PSC2.dist = PSC1.dist + mod_PSC2dist[m]*0.001;
	GCA3.dist = PSC2.dist - d1;
	GCA4.dist = PSC2.dist - d2;
	// adjust phases
	foc_time=0;
	foc_dist=0;
	foc_dt=0;
	double L0=0.0;
	double dL=0.0;
		
	if (mc == 1 ) {
		L0 = bp_dist + 0.5*(PSC1.dist+PSC3.dist);
		dL = PSC3.dist - PSC1.dist;
		PSC1.phase = getChopperPhase(L0,PSC1.nu,lam0,-PSC1.win/2.0, 0.0);
		PSC3.phase = getChopperPhase(L0,PSC3.nu,lam0,+PSC3.win/2.0, 0.0);
		PSC3.flip=1;
		foc_time = L0/v0+t_offset;
		foc_dist = L0;
		foc_dt = dL/L0*foc_time*2;	
	} else if (mc == 2 || mc == 3) {
		L0 = bp_dist + 0.5*(PSC1.dist+PSC2.dist);
		dL = PSC2.dist - PSC1.dist;
		PSC1.phase = getChopperPhase(L0,PSC1.nu,lam0,-PSC1.win/2.0, 0.0);
		PSC2.phase = getChopperPhase(L0,PSC2.nu,lam0,+PSC2.win/2.0, 0.0);
		PSC2.flip=1;
		foc_time = L0/v0+t_offset;
		foc_dist = L0;
		foc_dt = dL/L0*foc_time*2;
	} else if (mc == 4 || mc == 5 || mc == 6) {
		if (mcmult==16) {
			L0 = bp_dist + MCB.dist;
			MCB.phase = getChopperPhase(L0,MCB.nu,lam0,0.0, 0.0);
		} else if (mcmult==4) {
			L0 = bp_dist + 0.5*(MCA.dist + MCB.dist);
			MCA.phase = getChopperPhase(bp_dist + MCA.dist, MCA.nu,lam0,0.0, 0.0);
			MCB.phase = getChopperPhase(bp_dist + MCB.dist, MCB.nu,lam0,0.0, 0.0);
		// 8 is default
		} else { 
			L0 = bp_dist + MCA.dist;
			MCA.phase = getChopperPhase(L0,MCA.nu,lam0,0.0, 0.0);
		}
		
	} else if (mc == 7) {
		L0 = bp_dist + MCC.dist;
		MCC.phase = getChopperPhase(L0,MCC.nu,lam0+lamT*1.1,0.0,0.0);
	}

	Lchopper = L0;
	// calculate main ToF values
	tof_t0 = L0/v0;
	tof_sample = Lsample/v0;
	tof_det = (Lsample+Ldet)/v0;
	
	// FC choppers phases for given wavelength selection mode
	// single frame
	if (mw==1) {
		// fine adjustments of delay to avoid frame overlaps
		FC1A.phase=getChopperPhase(bp_dist + FC1A.dist,FC1A.nu,lam0, 0.0, 0.0);
		FC2A.phase=getChopperPhase(bp_dist + FC2A.dist,FC2A.nu,lam0, 0.0, 0.0);
	}
	// double frame - pulse suppression
	if (mw==2) {
		FC1A.phase=getChopperPhase(bp_dist + FC1A.dist,FC1A.nu,lam0+0.5*lamT, 0.0, 0.0);
		FC2A.phase=getChopperPhase(bp_dist + FC2A.dist,FC2A.nu,lam0+0.5*lamT, 0.0, 0.0);
	}
	// alternate frames 
	if (mw==3) {
		FC1A.phase=getChopperPhase(bp_dist + FC1A.dist,FC1A.nu,lam0+2*lamT, 0.0, 0.0);
		FC1B.phase=getChopperPhase(bp_dist + FC1B.dist,FC1B.nu,lam0+2*lamT, 0.0, 0.0);
		FC2B.phase=getChopperPhase(bp_dist + FC2B.dist,FC2B.nu,lam0+2*lamT, 9.0, 0.0);
	}
	// Set radial collimator
	// not used in this model: no secondary part
	setCollimator(colw); 
};
   
