/* Setting of the secondary radial collimator, (ENGIN-X system) 
Allowed widths are 0.5, 1, 2, 3, 4 mm
*/
void setCollimator(double width)  {
	Rad2On=1;
	// select distance according to width,
	if (width==0.5) {
		col_rad=cold[0];
	} else if (width==1) { 
		col_rad=cold[1];
	} else if (width==2) {
		col_rad=cold[2];
	} else if (width==3) {
		col_rad=cold[3];
	} else if (width==4) {
		col_rad=cold[4];
	} else { 
		printf("WARNING: invalid collimator width (%g), the collimator is removed.\n",width);
		col_rad=cold[2];
		Rad2On=0;
	}
	// calculate height (add max. sample height 2 cm)
	col_h1=0.02+2*col_rad*tan(col_angv*DEG2RAD/2);
	col_h2=0.02+2*(col_rad+col_len)*tan(col_angv*DEG2RAD/2);
}
      
   
