double getChopperPhase(double dist, double frq, double lam0, double angoffset, double timeoffset) {
	double phase;
	double v0 = K2V*2*PI/lam0; 
	if (fabs(frq) != 0.0) {
		phase=(dist/v0  + timeoffset)*fabs(frq)*360+angoffset;
		printf("Set chopper phase, dist=%g, f=%g, lam0=%g, angoff=%g, v0=%g, phase=%g\n",dist,frq,lam0,angoffset,v0, phase);
	} else {
		phase=0.0;
	}
	return phase;
}
  
void writeTaperingFile(char* file_name, double ell[], int dir, double zin, TGuideTA *F) {
	double h1,h2,w1,w2,dL,dx,dy;
	int i;
	FILE *hfile;
	hfile=fopen(file_name,"w");
	if (!hfile)
	{
        fprintf(stderr,"writeTaperingFile: can't open file for output (%s)\n",file_name);
        exit(-1);
	} else {
		fprintf(hfile, "c guide tapering file for %s\n",file_name);
		fprintf(hfile, "c segments i=0 .. %d\n",F->nseg-1);
		fprintf(hfile, "c h1(i)     h2(i)   w1(i)    w2(i)\n");
		dL=F->L/F->nseg;
		if (dir==0) { // horizontal 
			dx=0;
			dy=(F->h2-F->h1)/F->L;
		} else {
			dy=0;
			dx=(F->w2-F->w1)/F->L;
		}		
		for (i=0;i<F->nseg;i++) {
			if (dir==0) { // horizontal 
				w1=getEllipse(ell, zin+i*dL);
				w2=getEllipse(ell, zin+(i+1)*dL);
				h1=F->h1+i*dy*dL;
				h2=F->h1+(i+1)*dy*dL;
			} else { // vertical
				h1=getEllipse(ell, zin+i*dL);
				h2=getEllipse(ell, zin+(i+1)*dL);
				w1=F->w1+i*dx*dL;
				w2=F->w1+(i+1)*dx*dL;
			}
			fprintf(hfile, "%g %g %g %g\n",h1, h2, w1, w2);
		}
		fprintf(hfile, "%g   %g",h2, w2);
		fclose(hfile);
	}	
}  

