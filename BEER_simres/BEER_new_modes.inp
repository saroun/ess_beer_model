cmd GRSAVE FILE SANS_lam.dat
cmd GRSAVE OVER no
do GRSAVE 

#-----------------------------------------------------------------------
# 12, DS0, diffraction + SANS, modulation, in-situ thermomechanical experiment, 5.0, 10.0, 25.0, 25.0, 40.0, 40.0, 0, 2.10, 6, 3
#-----------------------------------------------------------------------
set INST LAMBDA 4.35
XML UPDATE

set FC1A ADJ 1
set FC2A ADJ 1
# FC1A on
set FC1A FRQ 14.0
set FC1A TIMING 0:1
XML FC1A
# FC2A on
set FC2A FRQ 7.0
set FC2A TIMING 0:1
XML FC2A
set FC1A ADJ 0
set FC2A ADJ 0

set INST LAMBDA 5.7
XML UPDATE
set MCC FRQ 70.0
set MCC T0 1
XML MCC

set SL1 SIZE(1)  40.0
set SL1 SIZE(2) 40.0
XML SL1
set SL2 SIZE(1)  25.0
set SL2 SIZE(2) 25.0
XML SL2
set GEX1 ACTIVE 0 0 0 0
XML GEX1
set SL3 SIZE(1)  5.0
set SL3 SIZE(2) 10.0
XML SL3

cmd BEAM1D COM DS0 mode
DO MC
DO BEAM1D
cmd GRSAVE FILE DS0_lam.dat
cmd GRSAVE OVER no
do GRSAVE 


#-----------------------------------------------------------------------
# 13, DS1, diffraction + SANS, pulse shaping, in-situ thermomechanical experiment, 5.0, 10.0, 25.0, 25.0, 40.0, 40.0, 0, 3.50, 1, 2
# simulate each frame separately
#-----------------------------------------------------------------------

set SOURCE LAMW 2
XML SOURCE

# FC1A on
set FC1A FRQ 14.0
set FC1A TIMING 0.0:1
XML FC1A
# FC1B on
set FC1B FRQ 63.0
set FC1B TIMING 0:1
XML FC1B
# FC2B on
set FC2B FRQ 7.0
set FC2B TIMING 0:1
XML FC2B

set PSC1 FRQ 168.0
set PSC1 TIMING 0.2:1
set PSC1 T0 1
set PSC1 LOCKT0 1
XML PSC1
set PSC3 FRQ -168.0
set PSC3 TIMING 0.2:1
set PSC3 T0 1
set PSC3 LOCKT0 1
XML PSC3

# set choppers phase to the shorter wavelength and fix phase
set FC1B ADJ 1
set PSC1 ADJ 1
set PSC3 ADJ 1
set FC2B ADJ 1
set INST LAMBDA 2.1
XML UPDATE
set FC1B ADJ 0
set PSC1 ADJ 0
set PSC3 ADJ 0
set FC2B ADJ 0

# set  FC1A phase to lambda + 1x bandwidth and fix phase
set FC1A ADJ 1
set INST LAMBDA 3.8884
XML UPDATE
set FC1A ADJ 0

set SL1 SIZE(1)  40.0
set SL1 SIZE(2) 40.0
XML SL1
set SL2 SIZE(1)  25.0
set SL2 SIZE(2) 25.0
XML SL2
set GEX1 ACTIVE 0 0 0 0
XML GEX1
set SL3 SIZE(1)  5.0
set SL3 SIZE(2) 10.0
XML SL3


# simulate the 1st frame
set INST LAMBDA 2.1
XML UPDATE

cmd BEAM1D COM DS1 mode
DO MC
DO BEAM1D
cmd GRSAVE FILE DS1_lam_1.dat
cmd GRSAVE OVER no
do GRSAVE 


# shift phases of FC1B and FC2B by one source period
set FC1B TIMING 4.5:1
XML FC1B
set FC2B TIMING 0.5:1
XML FC2B

# simulate the 2nd  frame
set INST LAMBDA 5.6769
XML UPDATE

cmd BEAM1D COM DS1 mode
DO MC
DO BEAM1D
cmd GRSAVE FILE DS1_lam_2.dat
cmd GRSAVE OVER no
do GRSAVE 

# reset default
set FC1B TIMING 0:1
XML FC1B
set FC2B TIMING 0:1
XML FC2B
set FC1B ADJ 1
set PSC1 ADJ 1
set PSC3 ADJ 1
set FC2B ADJ 1


#----------------------------------------------------------------------
# Cross-validation with McStas:
# PS0 modes with open slit 3, zero waviness and misalignment
#-----------------------------------------------------------------------

set INST LAMBDA 2.1
XML UPDATE

# FC1A on
set FC1A FRQ 28.0
set FC1A TIMING 0:1
XML FC1A
# FC2A on
set FC2A FRQ 14.0
set FC2A TIMING 0:1
XML FC2A

set PSC1 FRQ 168.0
set PSC1 TIMING 0.2:1
set PSC1 T0 1
set PSC1 LOCKT0 1
XML PSC1
set PSC3 FRQ -168.0
set PSC3 TIMING 0.2:1
set PSC3 T0 1
set PSC3 LOCKT0 1
XML PSC3
set SL1 SIZE(1) 40.0
set SL1 SIZE(2) 80.0
XML SL1
set SL2 SIZE(1) 40.0
set SL2 SIZE(2) 80.0
XML SL2
set GEX1 ACTIVE 1 1 1 1
XML GEX1
set SL3 SIZE(1) 100.0
set SL3 SIZE(2) 100.0
XML SL3


set NBOA MISALIGN 0.0 0.0
set BBG MISALIGN 0.0 0.0
set GSW MISALIGN 0.0 0.0
set GCA1 MISALIGN 0.0 0.0
set GCA2 MISALIGN 0.0 0.0
set GCA3 MISALIGN 0.0 0.0
set GCA4 MISALIGN 0.0 0.0
set GCB MISALIGN 0.0 0.0
set GCC MISALIGN 0.0 0.0
set GCE MISALIGN 0.0 0.0
set GCF MISALIGN 0.0 0.0
set GCG MISALIGN 0.0 0.0
set GE1 MISALIGN 0.0 0.0
set GN1 MISALIGN 0.0 0.0
set GN2 MISALIGN 0.0 0.0
set GSH2 MISALIGN 0.0 0.0
set GE2A MISALIGN 0.0 0.0
set GE2B MISALIGN 0.0 0.0
set GT1 MISALIGN 0.0 0.0
set GT2 MISALIGN 0.0 0.0
set GF1 MISALIGN 0.0 0.0
set GF2 MISALIGN 0.0 0.0
set GEX1 MISALIGN 0.0 0.0


set NBOA WAV 0.0
set BBG WAV 0.0
set GSW WAV 0.0
set GCA1 WAV 0.0
set GCA2 WAV 0.0
set GCA3 WAV 0.0
set GCA4 WAV 0.0
set GCB WAV 0.0
set GCC WAV 0.0
set GCE WAV 0.0
set GCF WAV 0.0
set GCG WAV 0.0
set GE1 WAV 0.0
set GN1 WAV 0.0
set GN2 WAV 0.0
set GSH2 WAV 0.0
set GE2A WAV 0.0
set GE2B WAV 0.0
set GT1 WAV 0.0
set GT2 WAV 0.0
set GF1 WAV 0.0
set GF2 WAV 0.0
set GEX1 WAV 0.0



set TR CNT 1000000
set TR DIR 0
DO MC

# autoscale
cmd BEAM1D XAUTO 1

cmd BEAM1D COM PS0, validation, zero waviness and misalignment
cmd BEAM1D X 8
DO BEAM1D
cmd GRSAVE FILE PS0_val_lam.dat
cmd GRSAVE OVER no
do GRSAVE 

cmd BEAM1D X 6
DO BEAM1D
cmd GRSAVE FILE PS0_val_t.dat
cmd GRSAVE OVER no
do GRSAVE 

cmd BEAM1D X 3
DO BEAM1D
cmd GRSAVE FILE PS0_val_kx.dat
cmd GRSAVE OVER no
do GRSAVE 

cmd BEAM1D X 4
DO BEAM1D
cmd GRSAVE FILE PS0_val_ky.dat
cmd GRSAVE OVER no
do GRSAVE 

cmd BEAM1D X 0
DO BEAM1D
cmd GRSAVE FILE PS0_val_x.dat
cmd GRSAVE OVER no
do GRSAVE 

cmd BEAM1D X 1
DO BEAM1D
cmd GRSAVE FILE PS0_val_y.dat
cmd GRSAVE OVER no
do GRSAVE 





