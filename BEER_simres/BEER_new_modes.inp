XML FC2A

set SL1 SIZE(1)  20.0
set SL1 SIZE(2) 20.0
XML SL1
set SL2 SIZE(1)  15.0
set SL2 SIZE(2) 15.0
XML SL2
set GEX1 ACTIVE 0 0 0 0
XML GEX1
set SL3 SIZE(1)  10.0
set SL3 SIZE(2) 10.0
