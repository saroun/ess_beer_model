#-----------------------------------------------------------------------
# 11, SANS, White beam, SANS, 10.0, 10.0, 15.0, 15.0, 20.0, 20.0, 0, 6.00, 0, 1
#-----------------------------------------------------------------------
set INST LAMBDA 6.0
XML UPDATE

# FC1A on
set FC1A FRQ 28.0
set FC1A TIMING 0.0:1
set FC1A OVERLAP 1
XML FC1A
# FC2A on
set FC2A FRQ 14.0
set FC2A TIMING 0:1
