


# load bi-spectral source 
set SOURCE FLUXTAB ESS2016_W2_thermal_5ms.tab
XML SOURCE

# load bi-spectral source 
set SOURCE FLUXTAB ESS2016_W2_cold_5ms.tab
XML SOURCE


# load bi-spectral source 
set SOURCE FLUXTAB ESS2016_W2_thermal_5ms.tab:ESS2016_W2_cold_5ms.tab
XML SOURCE

# set MCC chopper slits
set MCC TIMING 0:45:0.3125:1:0.375:1:0.4375:1:0.5:1:0.5625:1:0.625:1:0.6875:1
XML MCC

# set wavelength range 1 .. 3
#-------------------------
set INST LAMBDA 2
XML UPDATE
set SOURCE LAMW 1.0
XML SOURCE

# set wavelength range 0.5 .. 6.5
#-------------------------
set INST LAMBDA 3.5
XML UPDATE
set SOURCE LAMW 1.7143
XML SOURCE


# set wavelength range 0.2 .. 8.2
#-------------------------
set INST LAMBDA 4.2
XML UPDATE
set SOURCE LAMW 1.9047
XML SOURCE

# set wavelength range 0.2 .. 10.2
#-------------------------
set INST LAMBDA 5.2
XML UPDATE
set SOURCE LAMW 1.923077
XML SOURCE

# set sample slit as needed
#--------------------------------------
# open by default
set SL3 SIZE(1)  100.0
set SL3 SIZE(2) 100.0
XML SL3


# Set waviness and misalignment
#-----------------------------------------------

set NBOA MISALIGN 0.02 0.02
set BBG MISALIGN 0.02 0.02
set GSW MISALIGN 0.02 0.02
set GCA1 MISALIGN 0.02 0.02
set GCA2 MISALIGN 0.02 0.02
set GCA3 MISALIGN 0.02 0.02
set GCA4 MISALIGN 0.02 0.02
set GCB MISALIGN 0.02 0.02
set GCC MISALIGN 0.02 0.02
set GCE MISALIGN 0.02 0.02
set GCF MISALIGN 0.02 0.02
set GCG MISALIGN 0.02 0.02
set GE1 MISALIGN 0.02 0.02
set GN1 MISALIGN 0.02 0.02
set GN2 MISALIGN 0.02 0.02
set GSH2 MISALIGN 0.02 0.02
set GE2A MISALIGN 0.02 0.02
set GE2B MISALIGN 0.02 0.02
set GT1 MISALIGN 0.02 0.02
set GT2 MISALIGN 0.02 0.02
set GF1 MISALIGN 0.02 0.02
set GF2 MISALIGN 0.02 0.02
set GEX1 MISALIGN 0.02 0.02


set NBOA WAV 0.2
set BBG WAV 0.2
set GSW WAV 0.2
set GCA1 WAV 0.2
set GCA2 WAV 0.2
set GCA3 WAV 0.2
set GCA4 WAV 0.2
set GCB WAV 0.2
set GCC WAV 0.2
set GCE WAV 0.2
set GCF WAV 0.2
set GCG WAV 0.2
set GE1 WAV 0.2
set GN1 WAV 0.2
set GN2 WAV 0.2
set GSH2 WAV 0.2
set GE2A WAV 0.2
set GE2B WAV 0.2
set GT1 WAV 0.2
set GT2 WAV 0.2
set GF1 WAV 0.2
set GF2 WAV 0.2
set GEX1 WAV 0.2




#-----------------------------------------------------------------
# WAVELENGTH SELECTION MODES
#----------------------------------------------------------------
# NOTE: always start with mode 0 before executing the script for swicthing to another mode
# 

# To check for frame overlaps, set choppers like this:
set FC2A OVERLAP 1
set FC2B OVERLAP 1
set FC1A OVERLAP 1
set FC1B OVERLAP 1
set PSC1 OVERLAP 1
set PSC2 OVERLAP 1
set PSC3 OVERLAP 1
set MCA OVERLAP 1
set MCB OVERLAP 1
set MCC OVERLAP 1

# To ignore  frame overlaps and speed up simulation, set choppers like this:
set FC2A OVERLAP 0
set FC2B OVERLAP 0
set FC1A OVERLAP 0
set FC1B OVERLAP 0
set PSC1 OVERLAP 0
set PSC2 OVERLAP 0
set PSC3 OVERLAP 0
set MCA OVERLAP 0
set MCB OVERLAP 0
set MCC OVERLAP 0



#------------------------------------------------------
#  COLLIMATORS
#------------------------------------------------------
# in RAD, load appropriate component RAD_xmm.rxcp, where x=collimation width.
# Then set correct distances:

# 0.5 mm:
set RAD DIST 100.0
XML RAD
set DET DIST 1900.0
XML DET

# 1.0 mm:
set RAD DIST 160.0
XML RAD
set DET DIST 1840.0
XML DET

# 2.0 mm:
set RAD DIST 310.0
XML RAD
set DET DIST 1690.0
XML DET

# 4.0 mm:
set RAD DIST 490.0
XML RAD
set DET DIST 1510.0
XML DET




#----------------------------------------------------------------------------------------------------------------------------------------------
#----------------------------------------------------------------------------------------------------------------------------------------------
# REFERENCE OPERATION MODES
# Start with full open beam, F0, then use the setting below
#----------------------------------------------------------------------------------------------------------------------------------------------
#----------------------------------------------------------------------------------------------------------------------------------------------

# set waviness
set NBOA WAV 0.2
set BBG WAV 0.2
set GSW WAV 0.2
set GCA1 WAV 0.2
set GCA2 WAV 0.2
set GCA3 WAV 0.2
set GCA4 WAV 0.2
set GCB WAV 0.2
set GCC WAV 0.2
set GCE WAV 0.2
set GCF WAV 0.2
set GCG WAV 0.2
set GE1 WAV 0.2
set GN1 WAV 0.2
set GN2 WAV 0.2
set GSH2 WAV 0.2
set GE2A WAV 0.2
set GE2B WAV 0.2
set GT1 WAV 0.2
set GT2 WAV 0.2
set GF1 WAV 0.2
set GF2 WAV 0.2
set GEX1 WAV 0.2

# set misalignment
set NBOA MISALIGN 0.02 0.02
set BBG MISALIGN 0.02 0.02
set GSW MISALIGN 0.02 0.02
set GCA1 MISALIGN 0.02 0.02
set GCA2 MISALIGN 0.02 0.02
set GCA3 MISALIGN 0.02 0.02
set GCA4 MISALIGN 0.02 0.02
set GCB MISALIGN 0.02 0.02
set GCC MISALIGN 0.02 0.02
set GCE MISALIGN 0.02 0.02
set GCF MISALIGN 0.02 0.02
set GCG MISALIGN 0.02 0.02
set GE1 MISALIGN 0.02 0.02
set GN1 MISALIGN 0.02 0.02
set GN2 MISALIGN 0.02 0.02
set GSH2 MISALIGN 0.02 0.02
set GE2A MISALIGN 0.02 0.02
set GE2B MISALIGN 0.02 0.02
set GT1 MISALIGN 0.02 0.02
set GT2 MISALIGN 0.02 0.02
set GF1 MISALIGN 0.02 0.02
set GF2 MISALIGN 0.02 0.02
set GEX1 MISALIGN 0.02 0.02

# To check for frame overlaps, set choppers like this:
set FC2A OVERLAP 1
set FC2B OVERLAP 1
set FC1A OVERLAP 1
set FC1B OVERLAP 1
set PSC1 OVERLAP 1
set PSC2 OVERLAP 1
set PSC3 OVERLAP 1
set MCA OVERLAP 1
set MCB OVERLAP 1
set MCC OVERLAP 1

# disable multiple source pulses and set wide wavelength bandwidth
set SOURCE OVERLAP 0
set SOURCE LAMW 6.0
XML SOURCE


#---------------------------------------------------
# mode F0, all choppers stopped
#----------------------------------------------------
# FC1A off
set FC1A FRQ 0.0
set FC1A TIMING 0:1
set FC1A T0 0
set FC1A LOCKT0 0
set FC1A ADJ 1
XML FC1A
# FC1B off
set FC1B FRQ 0.0
set FC1B TIMING 0:1
set FC1B T0 0
set FC1B LOCKT0 0
set FC1B ADJ 1
XML FC1B
# FC2A off
set FC2A ADJ 1
set FC2A PHASE 0.0
set FC2A FRQ 0.0
set FC2A TIMING 0:1
set FC2A T0 0
set FC2A LOCKT0 0
set FC2A ADJ 1
XML FC2A
# FC2B off
set FC2B FRQ 0.0
set FC2B TIMING 0:1
set FC2B T0 0
set FC2B LOCKT0 0
set FC2B ADJ 1
XML FC2B

# modulation A off
set MCA FRQ 0
set MCA ADJ 1
set MCA T0 0
set MCA LOCKT0 0
XML MCA
# modulation B off
set MCB FRQ 0
set MCB ADJ 1
set MCB OVERLAP 0
set MCB T0 0
set MCB LOCKT0 0
XML MCB
# modulation C off
set MCC FRQ 0
set MCC ADJ 1
set MCC T0 0
set MCC LOCKT0 0
XML MCC
# PSC1 off
set PSC1 FRQ 0.0
set PSC1 TIMING 0:1
set PSC1 T0 0
set PSC1 LOCKT0 0
set PSC1 ADJ 1
XML PSC1
# PSC2 off
set PSC2 FRQ 0.0
set PSC2 TIMING 0:1
set PSC2 T0 0
set PSC2 LOCKT0 0
set PSC2 ADJ 1
XML PSC2
# PSC3 off
set PSC3 FRQ 0.0
set PSC3 TIMING 0:1
set PSC3 T0 0
set PSC3 LOCKT0 0
set PSC3 ADJ 1
XML PSC3
# Open slits and put GEX1 on by default
set SL1 SIZE(1) 40.0
set SL1 SIZE(2) 80.0
XML SL1
set SL2 SIZE(1) 40.0
set SL2 SIZE(2) 80.0
XML SL2
set GEX1 ACTIVE 1 1 1 1
XML GEX1
set SL3 SIZE(1) 100.0
set SL3 SIZE(2) 100.0
XML SL3


cmd BEAM1D COM F0 mode
DO MC
DO BEAM1D
cmd GRSAVE FILE F0_lam.dat
cmd GRSAVE OVER no
do GRSAVE 

#---------------------------------------------------
# mode F1: maximum beam with FC2A@14 Hz, phase=-0.8, with overlaps
#----------------------------------------------------
set INST LAMBDA 4.2
XML UPDATE
# FC2A on
set FC2A ADJ 0
set FC2A FRQ 14.0
set FC2A PHASE -0.8
set FC2A OVERLAP 1
XML FC2A
set SL3 SIZE(1) 100.0
set SL3 SIZE(2) 100.0
XML SL3

cmd BEAM1D COM F1 mode
DO MC
DO BEAM1D
cmd GRSAVE FILE F1_lam.dat
cmd GRSAVE OVER no
do GRSAVE 

#---------------------------------------------------
# mode F2: maximum beam with FC2A@14 Hz, phase=-0.8, with overlaps, beam 1x2 cm
#----------------------------------------------------
set INST LAMBDA 4.2
XML UPDATE
# FC2A on
set FC2A ADJ 0
set FC2A FRQ 14.0
set FC2A PHASE -0.8
set FC2A OVERLAP 1
XML FC2A
set SL3 SIZE(1) 10.0
set SL3 SIZE(2) 20.0
XML SL3

cmd BEAM1D COM F2 mode
DO MC
DO BEAM1D
cmd GRSAVE FILE F2_lam.dat
cmd GRSAVE OVER no
do GRSAVE 

#-----------------------------------------------------------------------
# 1, PS0, Maximum intensity,  pulse shaping, diffraction, max. slit, 10.0, 20.0, 25.0, 0.0, 0.0, 0.0, 1, 2.10, 1, 1
#-----------------------------------------------------------------------
set INST LAMBDA 2.1
XML UPDATE

# FC1A on
set FC1A FRQ 28.0
set FC1A TIMING 0:1
XML FC1A

# FC2A on
set FC2A FRQ 14.0
set FC2A TIMING 0:1
XML FC2A

set PSC1 FRQ 168.0
set PSC1 TIMING 0.2:1
set PSC1 T0 1
set PSC1 LOCKT0 1
XML PSC1
set PSC3 FRQ -168.0
set PSC3 TIMING 0.2:1
set PSC3 T0 1
set PSC3 LOCKT0 1
XML PSC3
set SL1 SIZE(1) 40.0
set SL1 SIZE(2) 80.0
XML SL1
set SL2 SIZE(1) 25.0
set SL2 SIZE(2) 80.0
XML SL2
set GEX1 ACTIVE 1 1 1 1
XML GEX1
set SL3 SIZE(1) 10.0
set SL3 SIZE(2) 20.0
XML SL3

cmd BEAM1D COM PS0 mode
DO MC
DO BEAM1D
cmd GRSAVE FILE PS0_lam.dat
cmd GRSAVE OVER no
do GRSAVE 

#-----------------------------------------------------------------------
# 2, PS1, High flux, pulse shaping, in-situ thermo mechanical experiment, 5.0, 10.0, 25.0, 0.0, 0.0, 0.0, 1, 2.10, 1, 1
#-----------------------------------------------------------------------
set INST LAMBDA 2.1
XML UPDATE

# FC1A on
set FC1A FRQ 28.0
set FC1A TIMING 0.0:1
XML FC1A
# FC2A on
set FC2A FRQ 14.0
set FC2A TIMING 0:1
XML FC2A

set PSC1 FRQ 168.0
set PSC1 TIMING 0.2:1
set PSC1 T0 1
set PSC1 LOCKT0 1
XML PSC1
set PSC3 FRQ -168.0
set PSC3 TIMING 0.2:1
set PSC3 T0 1
set PSC3 LOCKT0 1
XML PSC3
set SL1 SIZE(1) 40.0
set SL1 SIZE(2) 80.0
XML SL1
set SL2 SIZE(1) 25.0
set SL2 SIZE(2) 80.0
XML SL2
set GEX1 ACTIVE 1 1 1 1
XML GEX1
set SL3 SIZE(1) 5.0
set SL3 SIZE(2) 10.0
XML SL3

cmd BEAM1D COM PS1 mode
DO MC
DO BEAM1D
cmd GRSAVE FILE PS1_lam.dat
cmd GRSAVE OVER no
do GRSAVE 

#-----------------------------------------------------------------------
