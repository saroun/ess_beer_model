#-----------------------------------------------------------------------
set INST LAMBDA 2.1
XML UPDATE

# FC1A on
set FC1A FRQ 28.0
set FC1A TIMING 0.0:1
XML FC1A
# FC2A on
set FC2A FRQ 14.0
set FC2A TIMING 0:1
XML FC2A

set PSC1 FRQ 168.0
set PSC1 TIMING 0.2:1
set PSC1 T0 1
set PSC1 LOCKT0 1
XML PSC1
set PSC2 FRQ -168.0
set PSC2 TIMING 0.2:1
set PSC2 T0 1
set PSC2 LOCKT0 1
XML PSC2
set GCA3 DIST 277
XML GCA3
set GCB DIST 87
XML GCB
set SL1 SIZE(1) 35.0
set SL1 SIZE(2) 80.0
XML SL1
set SL2 SIZE(1) 23.0
set SL2 SIZE(2) 80.0
XML SL2
set GEX1 ACTIVE 1 1 1 1
XML GEX1
set SL3 SIZE(1) 5.0
set SL3 SIZE(2) 10.0
