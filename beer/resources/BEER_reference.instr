	R0 = R_0, alpha = m_alpha, Qc = m_Qc, W = m_W,
	mleft = GMINI.mL, mright = GMINI.mR, mtop = GMINI.mT, mbottom = GMINI.mB
)
AT (GMINI.shift + misfit_h*randnorm(), misfit_v*randnorm(), GMINI.dist) RELATIVE ISCS
ROTATED (0, GMINI.angle, 0) RELATIVE ISCS

/* ArmGEXstart: */
COMPONENT ArmGEXstart = Arm()
AT (ArmGEXstart.shift, 0, ArmGEXstart.dist) RELATIVE ISCS
ROTATED (0, ArmGEXstart.angle, 0) RELATIVE ISCS

/* JUMP: Jump to GEX1*/
JUMP ArmGEX1 WHEN (GF3On==1)

/* GEX2: Collimator on exchanger*/
COMPONENT cGEX2 = Collimator_linear(
	length = GEX2.L, xwidth = GEX2.w1, yheight = GEX2.h1
)
AT (GEX2.shift, 0, GEX2.dist) RELATIVE ISCS
ROTATED (0, GEX2.angle, 0) RELATIVE ISCS

/* ArmGEX2: */
COMPONENT ArmGEX2 = Arm()
AT (ArmGEX2.shift, 0, ArmGEX2.dist) RELATIVE ISCS
ROTATED (0, ArmGEX2.angle, 0) RELATIVE ISCS

/* JUMP: Jump to the end of exchanger*/
JUMP ArmGEXend WHEN (GF3On==0)

/* ArmGEX1: */
COMPONENT ArmGEX1 = Arm()
AT (ArmGEX1.shift, 0, ArmGEX1.dist) RELATIVE ISCS
ROTATED (0, ArmGEX1.angle, 0) RELATIVE ISCS

/* GEX1: Focusing guide on exchanger*/

COMPONENT cGEX1_0 = Guide_gravity(
	l = 0.366, w1 = 0.04, h1 = 0.049192, w2 = 0.04, h2 = 0.046273,
	R0 = R_0, alpha = m_alpha, Qc = m_Qc, W = m_W,
	mleft = 0.0, mright = 0.0, mtop = 5.0, mbottom = 5.0
)
AT (misfit_h*randnorm(), misfit_v*randnorm(), 0.0005) RELATIVE PREVIOUS
ROTATED (0, 9.8714e-07, 0) RELATIVE PREVIOUS
COMPONENT cGEX1_1 = Guide_gravity(
	l = 0.249, w1 = 0.04, h1 = 0.046265, w2 = 0.04, h2 = 0.044107,
	R0 = R_0, alpha = m_alpha, Qc = m_Qc, W = m_W,
	mleft = 0.0, mright = 0.0, mtop = 5.0, mbottom = 5.0
)
AT (misfit_h*randnorm(), misfit_v*randnorm(), 0.367) RELATIVE PREVIOUS
ROTATED (0, 7.5041e-15, 0) RELATIVE PREVIOUS
COMPONENT cGEX1_2 = Guide_gravity(
	l = 0.249, w1 = 0.04, h1 = 0.044098, w2 = 0.04, h2 = 0.041776,
	R0 = R_0, alpha = m_alpha, Qc = m_Qc, W = m_W,
	mleft = 0.0, mright = 0.0, mtop = 5.0, mbottom = 5.0
)
AT (misfit_h*randnorm(), misfit_v*randnorm(), 0.25) RELATIVE PREVIOUS
ROTATED (0, 0, 0) RELATIVE PREVIOUS
COMPONENT cGEX1_3 = Guide_gravity(
	l = 0.249, w1 = 0.04, h1 = 0.041766, w2 = 0.04, h2 = 0.039251,
	R0 = R_0, alpha = m_alpha, Qc = m_Qc, W = m_W,
	mleft = 0.0, mright = 0.0, mtop = 5.0, mbottom = 5.0
)
AT (misfit_h*randnorm(), misfit_v*randnorm(), 0.25) RELATIVE PREVIOUS
ROTATED (0, 0, 0) RELATIVE PREVIOUS
COMPONENT cGEX1_4 = Guide_gravity(
	l = 0.249, w1 = 0.04, h1 = 0.03924, w2 = 0.04, h2 = 0.036491,
	R0 = R_0, alpha = m_alpha, Qc = m_Qc, W = m_W,
	mleft = 0.0, mright = 0.0, mtop = 5.0, mbottom = 5.0
)
AT (misfit_h*randnorm(), misfit_v*randnorm(), 0.25) RELATIVE PREVIOUS
ROTATED (0, -2.6165e-14, 0) RELATIVE PREVIOUS
COMPONENT cGEX1_5 = Guide_gravity(
	l = 0.199, w1 = 0.04, h1 = 0.03648, w2 = 0.04, h2 = 0.034077,
	R0 = R_0, alpha = m_alpha, Qc = m_Qc, W = m_W,
	mleft = 0.0, mright = 0.0, mtop = 5.0, mbottom = 5.0
)
AT (misfit_h*randnorm(), misfit_v*randnorm(), 0.25) RELATIVE PREVIOUS
ROTATED (0, -1.1306e-14, 0) RELATIVE PREVIOUS
COMPONENT cGEX1_6 = Guide_gravity(
	l = 0.199, w1 = 0.04, h1 = 0.034065, w2 = 0.04, h2 = 0.031434,
	R0 = R_0, alpha = m_alpha, Qc = m_Qc, W = m_W,
	mleft = 0.0, mright = 0.0, mtop = 5.0, mbottom = 5.0
)
AT (misfit_h*randnorm(), misfit_v*randnorm(), 0.2) RELATIVE PREVIOUS
ROTATED (0, 0, 0) RELATIVE PREVIOUS
COMPONENT cGEX1_7 = Guide_gravity(
	l = 0.099, w1 = 0.04, h1 = 0.03142, w2 = 0.04, h2 = 0.030007,
	R0 = R_0, alpha = m_alpha, Qc = m_Qc, W = m_W,
	mleft = 0.0, mright = 0.0, mtop = 5.0, mbottom = 5.0
)
AT (misfit_h*randnorm(), misfit_v*randnorm(), 0.2) RELATIVE PREVIOUS
ROTATED (0, 8.9205e-15, 0) RELATIVE PREVIOUS

/* ArmGEXend: */
COMPONENT ArmGEXend = Arm()
AT (ArmGEXend.shift, 0, ArmGEXend.dist) RELATIVE ISCS
ROTATED (0, ArmGEXend.angle, 0) RELATIVE ISCS

/* SL3: Sample input slit, adjustable distance and size*/
COMPONENT cSL3 = Slit(xwidth = SL3.w, yheight = SL3.h)
AT (SL3.shift, 0, SL3.dist) RELATIVE ISCS
ROTATED (0, SL3.angle, 0) RELATIVE ISCS

/* Sample_axis: */
COMPONENT Sample_axis = Arm()
AT (Sample_axis.shift, 0, Sample_axis.dist) RELATIVE ISCS
ROTATED (0, Sample_axis.angle, 0) RELATIVE ISCS

/* -------------------------------------------------
End of automatically generated code - beamline components
---------------------------------------------------*/


/*In order to obtain the correct event data it is necessary to place a sourceMantid arm with the position in the proper length of the instrument*/

COMPONENT sourceMantid = Arm( )
AT (0, 0, -Lsample+Lchopper) RELATIVE Sample_axis
ROTATED (0, 0, 0) RELATIVE Sample_axis



/* --------------------------------------------------------------------------------
End of primary beamline
-----------------------------------------------------------------------------------*/  


COMPONENT TWidth = Monitor_nD(filename = "TWidth.dat", xwidth=mwidth, yheight=mheight, user1="SrcX", username1="Source position / [m]", 
options=options1, restore_neutron=1, nowritefile=!monoutputs)
  AT (0, 0, 0) RELATIVE Sample_axis

/* Monitor beam characteristics */

COMPONENT Lmon = L_monitor(
    nL = 100, filename = "Lmon.dat", xwidth = mwidth, yheight = mheight,
    Lmin = mlam1, Lmax = mlam2, restore_neutron = 1)
  AT (0, 0, 0) RELATIVE Sample_axis


COMPONENT TofMon = TOF_monitor(
    nt = 160, filename = "TofMon.dat", xwidth = mwidth, yheight = mheight,
    tmin = mtof1*1e6, tmax = mtof2*1e6, restore_neutron = 1, nowritefile=!monoutputs)
  AT (0, 0, 0) RELATIVE Sample_axis


COMPONENT XMon = PSDlin_monitor(
    nbins = 100, filename = "XMon.dat", xwidth = mwidth,
    yheight = mheight, restore_neutron = 1, nowritefile=!monoutputs)
  AT (0, 0, 0) RELATIVE Sample_axis

COMPONENT YMon = PSDlin_monitor(
    nbins = 100, filename = "YMon.dat", xwidth = mheight,
    yheight = mwidth, restore_neutron = 1, vertical=1, nowritefile=!monoutputs)
  AT (0, 0, 0) RELATIVE Sample_axis

COMPONENT HDivMon =Div1D_monitor(
    ndiv = 100, filename = "HDivMon.dat", xwidth = mwidth, yheight = mheight, 
	maxdiv = 0.5*mdivx, restore_neutron = 1, nowritefile=!monoutputs)
  AT (0, 0, 0) RELATIVE Sample_axis
  
 COMPONENT VDivMon = Div1D_monitor(
    ndiv = 100, filename = "VDivMon.dat", xwidth = mwidth, yheight = mheight, 
	maxdiv = 0.5*mdivy, restore_neutron = 1, vertical=1, nowritefile=!monoutputs)
  AT (0, 0, 0) RELATIVE Sample_axis
  
COMPONENT DivMon = Divergence_monitor(
    nh = 100, nv = 100, filename = "DivMon.dat", xwidth = mwidth,
    yheight = mheight, maxdiv_h = 0.5*mdivx, maxdiv_v = 0.5*mdivy,
    restore_neutron = 1, nowritefile=!monoutputs)
  AT (0, 0, 0) RELATIVE Sample_axis

  COMPONENT XYMon = PSD_monitor(
    nx = 100, ny = 100, filename = "XYMon.dat", xwidth = mwidth,
    yheight = mheight, restore_neutron = 1, nowritefile=!monoutputs)
  AT (0, 0, 0) RELATIVE Sample_axis

 COMPONENT HDivPos = DivPos_monitor(
    nb = 100, ndiv = 100, filename = "HDivPos.dat", xwidth = mwidth,
    yheight = mheight, maxdiv = 0.5*mdivx, restore_neutron = 1, nowritefile=!monoutputs)
  AT (0, 0, 0) RELATIVE Sample_axis

COMPONENT VDivPos = DivPos_monitor(
    nb = 100, ndiv = 100, filename = "VDivPos.dat", xwidth = mheight,
    yheight = mwidth, maxdiv = 0.5*mdivy, restore_neutron = 1, vertical = 1, nowritefile=!monoutputs)
  AT (0, 0, 0) RELATIVE Sample_axis	
	
COMPONENT TofLam = TOFLambda_monitor(
    nL = 512, nt = 512, tmin = mtof1*1e6, tmax = mtof2*1e6,
    filename = "TofLam.dat", xwidth = mwidth, yheight = 0.1, Lmin = mlam1,
    Lmax = mlam2, restore_neutron = 1, nowritefile=!monoutputs)
  AT (0, 0, 0) RELATIVE Sample_axis
  
COMPONENT BSTPMon = PSD_monitor(
    nx = 100, ny = 100, filename = "BSTPMon.dat", xwidth = 0.5,
    yheight = 0.5, restore_neutron = 1, nowritefile=!monoutputs)
  AT (0, 0, 8.3) RELATIVE Sample_axis
  

       

	   
FINALLY
