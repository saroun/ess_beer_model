double s3h=0.0; // m] Sample slit height. If zero, use instrument default.
double s3dist=0.05; // [m] Sample slit distance from the sample. If zero, use instrument default.
int bs_on=1; // Sets the bi-spectral switch blades on (1) or off (0)


