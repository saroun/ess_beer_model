/* Ellipse function, return width / height of an elliptic guide at distnce z
ell[0] = minor semi axis, ell[1] = major semi axis, ell[2] = distance of the ellipse center
z = distance from the source
*/	
double getEllipse(double ell[], double z) {
  double x,y;
  x = (z-ell[2])/ell[1];
  y = 2*ell[0]*sqrt(1.0-x*x);
  return y;	
}

 /* Define parameters of an elliptic guide in McStas convention 
  ell = ellipse parameters {b, a, centre}
  dir = direction horizontal (0), vertical (1))
  zin,zout = distances of the start,end from the source
  F = GuideEG structure  
 */ 
void defEllipse(double ell[], int dir, double zin, double zout, TGuideEG *F) {
    double foc;
	if (ell==NULL) {
		// assume parallel guide
		F->ah = 1e6;
		F->bh = 0.5*F->w1;
		F->av = 1e6;
		F->bv = 0.5*F->h1;		
		F->ctr = 0.5*F->L;
		F->linh = 0;
		F->louth = 0;
		F->linh = 0;
		F->louth = 0;
	} else {
		foc=sqrt(ell[1]*ell[1]-ell[0]*ell[0]);
		if (dir==0) {
			F->w1=getEllipse(ell, zin );
			F->w2=getEllipse(ell, zout );
			F->linw=foc - (ell[2]-zin);
			F->loutw=foc + (ell[2]-zout); 
			F->ah = ell[1];
			F->bh = ell[0];
			F->ctr = ell[2]-zin;
			F->av = 1e6;
			F->bv = 0.5*F->h1;
		}	else {
			F->h1=getEllipse(ell, zin );
			F->h2=getEllipse(ell, zout );
			F->linh=foc - (ell[2]-zin);
			F->louth=foc + (ell[2]-zout); 
			F->av = ell[1];
			F->bv = ell[0];
			F->ctr = ell[2]-zin;
			F->ah = 1e6;
			F->bh = 0.5*F->w1;
		}	 
	}
}


void setCDiscDefault(TCDisc *C) {
	C->dist=0.0;
	C->win=144;
	C->h=0.1;
	C->R=0.35;
	C->nu=0.0;
	C->delay=0.0;
    C->ns=1;	
	C->flip=0;
    C->angle=0.0;	
	C->shift=0.0;
}

void setMDChopperDefault(TMDChopper *C) {
	C->dist=0.0;
	C->h=0.1;
	C->R=0.35;
	C->nu=0.0;
	C->delay=0.0;
    C->ns=1;
    C->angle=0.0;	
	C->shift=0.0;    
}

void setEGuideDefault(TGuideEG *G) {
	G->linh=1e6;
	G->louth=1e6; 
	G->linw=1e6;
	G->loutw=1e6;	
	G->RH=0;
	G->ah=1e6;
	G->av=1e6;
    G->angle=0.0;	
	G->shift=0.0;    
}

void adjustDChopper(TCDisc *C, double lam0,  double dist, double angoffset) {
/* Adjust DiscChopper for given wavelength, distance [m] and angular offset [deg]
   angoffset = counter-clockwise rotation around z-axis
*/
    double v0 = K2V*2*PI/lam0; 
    if (fabs(C->nu) > eps) {
        C->delay = dist/v0 - angoffset/360/C->nu;
    } else {
        C->delay = 0.0;
        C->nu = eps;
    }
}

void adjustMDChopper(TMDChopper *C, double lam0,  double dist, double angoffset) {
/* Adjust MultiDiscChopper for given wavelength, distance [m] and angular offset [deg]
   angoffset = counter-clockwise rotation around z-axis
   NOTE: MultiDiscChopper defines positive rotation clock-wise !!
*/
    double v0 = K2V*2*PI/lam0; 
    if (fabs(C->nu) > eps) {
        C->delay = dist/v0 - angoffset/360/C->nu;
    } else {
        C->delay = 0.0;
        C->nu = eps;
    }
}
 
void writeTaperingFile(char* file_name, double ell[], int dir, double zin, TGuideTA *F) {
	double h1,h2,w1,w2,dL,dx,dy;
	int i;
	FILE *hfile;
	hfile=fopen(file_name,"w");
	if (!hfile)
	{
        fprintf(stderr,"writeTaperingFile: can't open file for output (%s)\n",file_name);
        exit(-1);
	} else {
		fprintf(hfile, "c guide tapering file for %s\n",file_name);
		fprintf(hfile, "c segments i=0 .. %d\n",F->nseg-1);
		fprintf(hfile, "c h1(i)     h2(i)   w1(i)    w2(i)\n");
		dL=F->L/F->nseg;
		if (dir==0) { // horizontal 
			dx=0;
			dy=(F->h2-F->h1)/F->L;
		} else {
			dy=0;
			dx=(F->w2-F->w1)/F->L;
		}		
		for (i=0;i<F->nseg;i++) {
			if (dir==0) { // horizontal 
				w1=getEllipse(ell, zin+i*dL);
				w2=getEllipse(ell, zin+(i+1)*dL);
				h1=F->h1+i*dy*dL;
				h2=F->h1+(i+1)*dy*dL;
			} else { // vertical
				h1=getEllipse(ell, zin+i*dL);
				h2=getEllipse(ell, zin+(i+1)*dL);
				w1=F->w1+i*dx*dL;
				w2=F->w1+(i+1)*dx*dL;
			}
			fprintf(hfile, "%g %g %g %g\n",h1, h2, w1, w2);
		}
		fprintf(hfile, "%g   %g",h2, w2);
		fclose(hfile);
	}
}  

// Scattering angle for given detector pixel position and take-off angle in rad
double pixel_angle(double x, double y, double LD, double tth) {
	double x1, z1, si, co;
	si = sin(tth);
	co = cos(tth);
	x1 = LD*si + x*co;
	z1 = LD*co - x*si;
	int sg = x1>0?1:-1;
	double qT =  sg*sqrt(x1*x1+y*y);
	printf("x=%g, y=%g, z=%g, qT=%g\n",x1,y,z1,qT);
	double res = atan2(sqrt(x1*x1+y*y), z1);
	return res;
}

