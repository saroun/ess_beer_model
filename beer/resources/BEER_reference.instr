/* Functions and variables for counting statistics */
TStat stats[MAXCOMP]; // records transport statistics for components
double beam_z[MAXMON], beam_sum[MAXMON]; // records distance-intensity function
int nComponents = 0; 
int nMonitors = 0; 


   
// counter of neutrons emitted by the source  (can be used for statistics)  
long srccount;
#pragma acc declare create(srccount)
 
/* Add a component to count statistics */ 
void addComponent(char *id, int idx) {
	int nc = sizeof(stats[nComponents].id);
	memset(stats[nComponents].id, '\0', nc);
	int mc = (nc<=sizeof(id)) ? nc : sizeof(id);
	strncpy(stats[nComponents].id, id, mc);
	stats[nComponents].idx = idx;
	stats[nComponents].cnt = 0;
	stats[nComponents].sum = 0.0;
	nComponents ++;
} 

/* Add a beam segment for intensity monitoring */ 
void addBeamSegment(double dist) {
	beam_sum[nMonitors] = 0.0;
	beam_z[nMonitors] = dist;
	nMonitors ++;
} 

/* Print counting statistics */
void printStat() {
   double eff[MAXCOMP], effRel[MAXCOMP]; // efficiencies absolute and relative
   double sum, sumPre;
   int i;
   long cnt;
   FILE *hfile;
   sum = srccount;
   sumPre = sum;
   for (i=0;i<nComponents;i++) {
      cnt = stats[i].cnt;
         if  (cnt>0) {
         eff[i] = cnt/sum;
         effRel[i] = cnt/sumPre;
         sumPre = cnt;
      }
   }
   hfile=fopen("statistics.txt","w");
   printf("Counting statistics [ID, sum, counts, eff_rel, eff]:\n");
   if (hfile) fprintf(hfile, "Counting statistics [ID, sum, counts, eff_rel, eff]:\n");
   for (i=0;i<nComponents;i++) {
      if  (stats[i].cnt>0) {
         printf("[%d] %s:\t%g\t%ld\t%g\t%g\n",stats[i].idx ,stats[i].id, stats[i].sum, stats[i].cnt, effRel[i], eff[i]);
         if (hfile) fprintf(hfile, "%s:\t%g\t%ld\t%g\t%g\n",stats[i].id, stats[i].sum, stats[i].cnt, effRel[i], eff[i]);
      }
   }
   if (hfile) fclose(hfile);
   hfile=fopen("intensity.txt","w");
   if (hfile) {
	   fprintf(hfile, "Counting statistics [distance, intensity]:\n");
       for (i=0;i<nMonitors;i++) {
         if (hfile) fprintf(hfile, "%g\t%g\n",beam_z[i], beam_sum[i]);
       }
       fclose(hfile);
   }
}

/*--------------------------------------  
Basic instrument constants  
--------------------------------------*/

// sample - detector distance
   const double Ldet = 2.0; 
// moderator - sample distace
   const double Lsample = 158.0;
// pulse length
   const double tau=1.0/25/14;
// maximum pulse length including the pulse tail    
   const double taumax=1.75/25/14;   
// time to pulse centre [s]   
   const double t_offset = 0.0016;
// detector dimensions
   double det_x = 1.0; // horizontal
   double det_y = 1.0;  // vertical
// ISCS definition with respect to beamport coordinates   
   const double  bp_angle=0.3;   // insert axis angle
   const double  bp_x0=-0.03;    // beam centre at the moderator
   const double bp_dist=2.0305;  // distance of the front NBOA face from moderator    

// Standard mirror reflectivity parameters. 
   const double R_0=0.99;  // reflectivity at m<1											 
   const double  R_m3=0.85; // reflectivity at m=3
   const double  m_Qc=0.0218;
   const double  m_W=0.001;
   double  m_alpha = 3.44; // slope, common for all m-values, below initialized to (1.0-R_m3)/(m_Qc*2)

   // Parameters of secondary radial collimator
   const double cold[5]={0.100, 0.160, 0.310, 0.410, 0.490};  // distances for width options
   const double col_ang=30; // horizontal angle
   const double col_angv=30; // vertical angle
   const double col_d=0.0001; // blade thickness
   const int col_ns=160; // number of blades
   const double col_len=0.35; // length
   
/*-----------------------------------------------  
Setup variables. 
They are defined by mode setting,  see setMode()
-------------------------------------------------*/

// moderator -> pulse chopper distance
   double Lchopper; 
// Exchanger switcch on/off   
   int GF3On;
#pragma acc declare create(GF3On)

// nominal ToF values to the pulse chopper (t0) sample and detector (set for given lambda)
   double tof_t0, tof_sample, tof_det;
// source time focusing data
   double foc_time, foc_dist, foc_dt;
#pragma acc declare create(foc_pls)
   int foc_pls;
// d-range for given tth (take-off angle), detector span and wavelength range
   double d_min, d_max;
   
// radial collimator parameters, set in setCollimator()  
   double col_h1, col_h2; // entry and exit heights
   double col_rad; // radius (entry distance)
   #pragma acc declare create(Rad2On)
   int Rad2On; // Radial collimator on/off   
// other auxilliary variables
   char options1[256];
   
// variables for monitor ranges
   double mwidth, mheight, mtof1, mtof2, mdivx, mdivy, mlam1, mlam2; 


/* Setting of the secondary radial collimator, (ENGIN-X system) 
Allowed widths are 0.5, 1, 2, 3, 4 mm
*/
    void setCollimator(double width)  {
        Rad2On=1;
        // select distance according to width,
        if (width==0.5) {
            col_rad=cold[0];
        } else if (width==1) { 
            col_rad=cold[1];
        } else if (width==2) {
            col_rad=cold[2];
        } else if (width==3) {
            col_rad=cold[3];
        } else if (width==4) {
            col_rad=cold[4];
        } else { 
            printf("WARNING: invalid collimator width (%g), the collimator is removed.\n",width);
            col_rad=cold[2];
            Rad2On=0;
        }
        #pragma acc update device(Rad2On)
        // calculate height (add max. sample height 2 cm)
        col_h1=0.02+2*col_rad*tan(col_angv*DEG2RAD/2);
        col_h2=0.02+2*(col_rad+col_len)*tan(col_angv*DEG2RAD/2);
    }
      

/* Setting of operation modes 
m = operation mode
lam0 = nominal wavelength for chopper phase calculation
*/  
    void setMode(int m, double lam0, int nseg, int npulse) {
        double v0 = K2V*2*PI/lam0; 
        
        // wavelength bandwidth corresponfding to 1 period
//        double vT = (Lsample+Ldet)*14;
//        double lamT = K2V*2*PI/vT;
        
        // chopper modes for given reference mode
        int mw = mod_wmodes[m];
        int mc = mod_cmodes[m];
        
        // set bi-spectral switch on or off
        if (bs_on) {
            GSW.nseg=nseg;
        } else {
            GSW.nseg=0;
        }	
        
        // chopper frequencies
        PSC1.nu = cmode_f[mc][0];
        PSC2.nu = cmode_f[mc][1];
        PSC3.nu = cmode_f[mc][2];
        MCA.nu = cmode_f[mc][3];
        MCB.nu = cmode_f[mc][4];
        MCC.nu = cmode_f[mc][5];
        FC1A.nu = wmode_f[mw][0];
        FC1B.nu = wmode_f[mw][1];
        FC2A.nu = wmode_f[mw][2];
        FC2B.nu = wmode_f[mw][3];

        // chopper phase shifts
        PSC1.phi = cmode_phi[mc][0];
        PSC2.phi = cmode_phi[mc][1];
        PSC3.phi = cmode_phi[mc][2];
        MCA.phi = cmode_phi[mc][3];
        MCB.phi = cmode_phi[mc][4];
        MCC.phi = cmode_phi[mc][5];
        FC1A.phi = wmode_phi[mw][0] + mod_FC1A_dphi[m];
        FC1B.phi = wmode_phi[mw][1];
        FC2A.phi = wmode_phi[mw][2];
        FC2B.phi = wmode_phi[mw][3];
        
        // slits and foc. guide setting
        SL1.w = mod_S1_w[m]*0.001;
        SL2.w = mod_S2_w[m]*0.001;
        SL3.w = mod_S3_w[m]*0.001;
        SL1.h = mod_S1_h[m]*0.001;
        SL2.h = mod_S2_h[m]*0.001;
        SL3.h = mod_S3_h[m]*0.001;
        GF3On = mod_GF3[m];
#pragma acc update device(GF3On)

        // movable PSC2 with fixed GCA3 and GCA4
        //double d1 = PSC2.dist - GCA3.dist;
        //double d2 = PSC2.dist - GCA4.dist;
        PSC2.dist = PSC1.dist + mod_PSC2dist[m]*0.001;
        //GCA3.dist = PSC2.dist - d1;
        //GCA4.dist = PSC2.dist - d2;
		
		
        
        // adjust resolution choppers
        foc_time = 0;
        foc_dist = 0;
        foc_dt = 0;
        foc_pls = npulse;
        tof_det = (Lsample+Ldet)/v0;
        
        double L0 = 0.0;
        double dL = 0.0;
        // Wavelength and velocity corrected for pulse difference. 
        // Assumes wavelength selection at half of the source-detector distance
        double lam1 = lam0 - hovm*foc_pls/7/(Lsample+Ldet);
        double v1 = hovm/lam1;
        if (mc == 1 || mc == 2 || mc == 3) {
            if ( (fabs(PSC2.nu)<=eps) &&  (fabs(PSC1.nu)>eps) && (fabs(PSC3.nu)>eps)) {
                L0 = 0.5*(PSC1.dist+PSC3.dist);
                dL = PSC3.dist - PSC1.dist;
            } else if ( (fabs(PSC3.nu)<=eps) &&  (fabs(PSC1.nu)>eps) && (fabs(PSC2.nu)>eps)) {
                L0 = 0.5*(PSC1.dist+PSC2.dist);
                dL = PSC2.dist - PSC1.dist;
            } else if ( (fabs(PSC2.nu)<=eps) &&  (fabs(PSC1.nu)>eps) && (fabs(PSC3.nu)>eps)) {
               L0 = 0.5*(PSC2.dist+PSC3.dist);
               dL = PSC2.dist - PSC1.dist;
            } else {
                printf("Wrong setting: PSC choppers must be used in pairs.");
                exit(0);
            }
            if (v1>0.0) {
                foc_time = L0/v1 + t_offset;
                foc_dist = L0;
                foc_dt = dL/L0*foc_time*2;	
            } else {
                foc_time = 0;
                foc_dist = 0;
                foc_dt = 0;
                foc_pls = 0;
            }
        } else if (mc == 4 || mc == 5 || mc == 6) {
            if ((fabs(MCA.nu)>eps) && (fabs(MCB.nu)>eps)) {
                L0 = 0.5*(MCA.dist + MCB.dist);
            } else if (fabs(MCA.nu)>eps) {
                L0 = 0.5*MCA.dist;
            } else if (fabs(MCB.nu)>eps) {
                L0 = 0.5*MCB.dist;
            } else {
                printf("Wrong modulation mode: At least one MC chopper must rotate.");
                exit(0);
            }
        } else if (mc == 7) {
            L0 = MCC.dist;
        }
        
       // distance to time zero of resolution choppers
        Lchopper = L0;
        // calculate main ToF values
        tof_t0 = Lchopper/v0;
        tof_sample = Lsample/v0;
        
        
        // adjust PSC choppers
        adjustDChopper(&PSC1, lam0, Lchopper, PSC1.phi);
        adjustDChopper(&PSC2, lam0, Lchopper, PSC2.phi);
        adjustDChopper(&PSC3, lam0, Lchopper, PSC3.phi);
        
        // adjust MC choppers
        adjustDChopper(&MCA, lam0, Lchopper, MCA.phi);
        adjustDChopper(&MCB, lam0, Lchopper, MCB.phi); 
        adjustMDChopper(&MCC, lam0, Lchopper, MCC.phi);
        
        // adjust FC choppers
        adjustDChopper(&FC1A, lam0, FC1A.dist, FC1A.phi);
        adjustDChopper(&FC1B, lam0, FC1B.dist, FC1B.phi);
        adjustDChopper(&FC2A, lam0, FC2A.dist, FC2A.phi);
        adjustDChopper(&FC2B, lam0, FC2B.dist, FC2B.phi);

        // Set radial collimator
        // only used by secondary spectrometer, if defined
        setCollimator(colw);
#pragma acc update device(foc_pls)
    };
   
/* reporting functions */   
   void reportTSlit(char* name, TSlit F) {
		printf("%s: dist=%g, w=%g, h=%g\n",name,
		F.dist, F.w, F.h);   
	};
    
   void reportTArm(char* name, TArm F) {
		printf("%s: dist=%g, x=%g, angle=%g\n",name,
		F.dist, F.shift, F.angle);   
	};
    
	void reportTGuide(char* name, TGuide F) {
		printf("%s: dist=%g, x=%g, w1=%g, h1=%g, w2=%g, h2=%g, L=%g, end=%g\n",name,
		F.dist, F.shift, F.w1, F.h1, F.w2, F.h2, F.L, F.dist+F.L);   
	};
    
	void reportTCollimator(char* name, TCollimator F) {
		printf("%s: dist=%g, x=%g, w1=%g, h1=%g, w2=%g, h2=%g, L=%g, end=%g\n",name,
		F.dist, F.shift, F.w1, F.h1, F.w2, F.h2, F.L, F.dist+F.L);   
	};  
    
	void reportTGuideSeg(char* name, TGuideSeg F) {
		printf("%s: dist=%g, x=%g, w1=%g, h1=%g, w2=%g, h2=%g, L=%g, end=%g\n",name,
		F.dist, F.shift, F.w1, F.h1, F.w2, F.h2, F.L, F.dist+F.L);   
	};    

	void reportTGuideEG(char* name, TGuideEG F) {
		printf("%s: dist=%g, x=%g, w1=%g, h1=%g, w2=%g, h2=%g, L=%g, end=%g\n",name,
		F.dist, F.shift, F.w1, F.h1, F.w2, F.h2, F.L, F.dist+F.L);
		printf("\t ah=%g, bh=%g, av=%g, bv=%g, ctr=%g\n", F.ah, F.bh, F.av, F.bv, F.ctr);   		
	};
	void reportTGuideMC(char* name, TGuideMC F) {
		printf("%s: dist=%g, x=%g, w1=%g, h1=%g, w2=%g, h2=%g, L=%g, end=%g\n",name,
		F.dist, F.shift, F.w1, F.h1, F.w2, F.h2, F.L, F.dist+F.L);   
	};
	
	void reportTGuideTA(char* name, TGuideTA F) {
		printf("%s: dist=%g, x=%g, w1=%g, h1=%g, w2=%g, h2=%g, L=%g, end=%g\n",name,
		F.dist, F.shift, F.w1, F.h1, F.w2, F.h2, F.L, F.dist+F.L);   
	};
	
	void reportTCDisc(char* name, TCDisc C) {
		printf("%s: dist=%g, x=%g, win=%g, nu=%g, phase=%g\n", name,
			 C.dist, C.shift, C.win, C.nu, C.delay*C.nu);   
	};
	
	void reportTMDChopper(char* name, TMDChopper C) {
		printf("%s: dist=%g, x=%g, nu=%g, phase=%g, wins=%s, ctrs=%s\n", name,
			 C.dist, C.shift, C.nu, C.delay*C.nu, C.wins, C.ctrs);   
	};

%}

USERVARS %{
  // monitoring of emision position from the source   
  double SrcX;
  double SrcY;
  double SrcZ;
%}

INITIALIZE
%{  
dbgn=0;
    
    if (mode < 0 || mode > MAXMODE) {
        printf("Invalid mode number (%d). Valid mode range is (%d,%d).\n",mode,0,MAXMODE);
        exit(0);
    }
    if (lambda == 0) {
       lambda = mod_lambda[mode];
    }
	printf("BEER McStas file generated by %s on %s\n","beer.mcstas","March 04, 2025, 17:31:36");
	printf("Wavelength range [A]: %g, %g \n",Lmin,Lmax);
    printf("Reference mode: %d \n",mode);
    printf("Wavelength reference [A]: %g \n",lambda);
// slope of supermirror reflectivity 	
	m_alpha = (1.0-R_m3)/(m_Qc*2);
// mean velocity for phase setting
    double v0 = hovm/lambda;
    double vT = (Lsample+Ldet)*14; // wavelength bandwidth corresponding to 1 period
    double lamT = K2V*2*PI/vT;
	double vmax = hovm/Lmin;
    double vmin = hovm/Lmax;
// calculate theta and d-range 
    double thmin, thmax;
	// detector span [deg]
	double ah = atan2(0.5*det_x,Ldet)/DEG2RAD;  // horizontal
    double av = atan2(0.5*det_y,Ldet)/DEG2RAD;  // vertical
	
	// minimum scattering angle
	if (tth-ah <= 0.0) {
		thmin = 0.0;
	} else if (tth-ah <= 90.0) {
		thmin = 0.5*pixel_angle(-0.5*det_x, 0.0, Ldet, tth*DEG2RAD);
	} else {
		thmin = 0.5*pixel_angle(-0.5*det_x, 0.5*det_y, Ldet, tth*DEG2RAD);
	}
	// maximum scattering angle
	if (tth+ah <= 90.0) {
		thmax = 0.5*pixel_angle(0.5*det_x, 0.0, Ldet, tth*DEG2RAD);
	} else if (tth+ah < 180.0) {
		thmax = 0.5*pixel_angle(0.5*det_x, 0.5*det_y, Ldet, tth*DEG2RAD);
	} else {
		thmax = 0.499*PI;
	}
	
	// range of dhkl (for pattern calculation)
	d_min = 0.5*(lambda-0.5*lamT)/sin(thmax);
	d_max = fmin(0.5*(lambda+0.5*lamT)/sin(thmin),10.0);
	printf("Bragg angle span [deg]: %g, %g \n", thmin/DEG2RAD, thmax/DEG2RAD);
	printf("dhkl span [A]: %g, %g \n", d_min, d_max);
	
// clear source counter	
	srccount = 0;
#pragma acc update device(srccount)

/*  START OF INSTRUMENT GEOMETRY */	 

