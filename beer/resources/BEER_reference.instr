      reportTGuide("GCE", GCE);
      reportTCDisc("MCA", MCA);
      reportTCDisc("MCB", MCB);
      reportTGuide("GCF", GCF);
      reportTMDChopper("MCC", MCC);
      reportTGuide("GCG", GCG);
      reportTArm("ArmGE1A", ArmGE1A);
      reportTGuideSeg("GE1A", GE1A);
      reportTArm("ArmGE1B", ArmGE1B);
      reportTGuideSeg("GE1B", GE1B);
      reportTArm("ArmGN1", ArmGN1);
      reportTGuideSeg("GN1", GN1);
      reportTArm("ArmGN2", ArmGN2);
      reportTGuideSeg("GN2", GN2);


      /* Transport section*/
      reportTGuide("GSH2", GSH2);
      reportTGuide("GE2AS", GE2AS);
      reportTArm("ArmGE2A", ArmGE2A);
      reportTGuideSeg("GE2A", GE2A);
      reportTArm("ArmGE2B", ArmGE2B);
      reportTGuideSeg("GE2B", GE2B);
      reportTArm("ArmGT1", ArmGT1);
      reportTGuideSeg("GT1", GT1);
