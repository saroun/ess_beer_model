/* -------------------------------------------------
End of setup report
---------------------------------------------------*/
	    printf("\nPulse chopper at %g [m]\n",Lchopper);
		printf("\nToF length [m]: %g \n",Lsample-Lchopper);
	}
	// printf("Time focusing: dist=%g, time=%g, width=%g\n",foc_dist, foc_time, foc_dt);
    if (GF3On) {
        printf("Focusing guide GEX1 is on\n");
    } else {
        printf("Focusing guide GEX1 is off\n");
    }
// define source flux distribution range for Monitor_nD	
	sprintf(options1,"user1 bins=200 limits=[-0.1,0.1]");
	#ifdef USE_MPI
	MPI_Barrier(MPI_COMM_WORLD);
	#endif							 
%} 

TRACE

COMPONENT Origin = Progress_bar()
  AT (0,0,0) ABSOLUTE

/* 
COMPONENT ESS_W2 = MCPL_source( filename = "fW2.mcpl", Lmin=Lmin, Lmax=Lmax, smearing=1, verbose=0, I0=1.56e10)
AT(0,0,0) RELATIVE Origin
ROTATED (0 ,0 ,0) RELATIVE Origin 
EXTEND
%{ 
 SrcX=x;SrcY=y;SrcZ=z;
 #pragma acc atomic
 srccount = srccount + 1;
 t -= t_offset;
%}
*/
 
COMPONENT ESS_W2 = ESS_butterfly(sector="W", beamline=2, Lmin=Lmin, Lmax=Lmax, dist=0, target_index=+2,
 focus_xw=NBOA.w1+0.01, focus_yh=NBOA.h1+0.01, cold_frac=0.5, n_pulses=nframes, tmax_multiplier=taumax/tau, acc_power=5,
 tfocus_dist=foc_dist, tfocus_time=foc_time, tfocus_width=foc_dt)
AT (0, 0, 0) RELATIVE Origin 
EXTEND
%{ 
 SrcX=x;SrcY=y;SrcZ=z;
 #pragma acc atomic
 srccount = srccount + 1;
 t -= t_offset - foc_pls/14.0;
%}

// Define ISCS coordinates      
COMPONENT ISCS = Arm( )
  AT (bp_x0, 0, 0) RELATIVE Origin
  ROTATED (0, bp_angle, 0) RELATIVE Origin


/* ------------------------------------------------------------
Automatically generated code - beamline components
---------------------------------------------------------------*/

/*--------------------------------------------------
Monolith section
--------------------------------------------------*/

/* NBOA: monolith insert optics*/
COMPONENT cNBOA = Guide_tapering(
	option = "file=prof_NBOA.txt",
	l = NBOA.L, w1=0, h1=0, linw=0, loutw=0, linh=0, louth=0,
	R0 = R_0, alphax = m_alpha, alphay = m_alpha, Qcx = m_Qc, Qcy = m_Qc, W = m_W,
	mx = NBOA.mx, my = NBOA.my, segno = NBOA.nseg
)
AT (NBOA.shift, 0, NBOA.dist) RELATIVE ISCS
ROTATED (0, NBOA.angle, 0) RELATIVE ISCS

/* monNBOA: */
COMPONENT monNBOA = L_monitor(filename="monNBOA.dat", nL=100, Lmin=0.2, Lmax=10.2,
xwidth=0.1000, yheight=0.1000, restore_neutron=1, nowritefile=!monoutputs)
AT (0.00000, 0, 5.3915) RELATIVE ISCS
ROTATED (0, 0.00000, 0) RELATIVE ISCS

/* BBG: bridge beam guide*/
COMPONENT cBBG = Guide_tapering(
	option = "file=prof_BBG.txt",
	l = BBG.L, w1=0, h1=0, linw=0, loutw=0, linh=0, louth=0,
	R0 = R_0, alphax = m_alpha, alphay = m_alpha, Qcx = m_Qc, Qcy = m_Qc, W = m_W,
	mx = BBG.mx, my = BBG.my, segno = BBG.nseg
)
AT (BBG.shift, 0, BBG.dist) RELATIVE ISCS
ROTATED (0, BBG.angle, 0) RELATIVE ISCS

/*--------------------------------------------------
Bunker section
--------------------------------------------------*/

/* GSW: bi-spectral switch, adjustable angle, movable on/off the beam*/
COMPONENT cGSW = Guide_multichannel(
	l = GSW.L,w1 = GSW.w1, h1 = GSW.h1, w2 = GSW.w2, h2 = GSW.h2, 
	R0 = R_0, alphax = m_alpha, alphay = m_alpha, Qcx = m_Qc, Qcy = m_Qc, W = m_W, dlam = GSW.dlam,
	mx = GSW.mx, my = GSW.my, nslit = GSW.nseg+1, mater = "Si"
)
AT (GSW.shift, 0, GSW.dist) RELATIVE ISCS
ROTATED (0, GSW.angle, 0) RELATIVE ISCS

/* BM1: */
