/* Functions and variables for counting statistics */
TStat stats[MAXCOMP]; // records transport statistics for components
double beam_z[MAXMON], beam_sum[MAXMON]; // records distance-intensity function
int nComponents = 0; 
int nMonitors = 0; 


   
// counter of neutrons emitted by the source  (can be used for statistics)  
long srccount;
#pragma acc declare create(srccount)
 
/* Add a component to count statistics */ 
void addComponent(char *id, int idx) {
	int nc = sizeof(stats[nComponents].id);
	memset(stats[nComponents].id, '\0', nc);
	int mc = (nc<=sizeof(id)) ? nc : sizeof(id);
	strncpy(stats[nComponents].id, id, mc);
	stats[nComponents].idx = idx;
	stats[nComponents].cnt = 0;
	stats[nComponents].sum = 0.0;
	nComponents ++;
} 

/* Add a beam segment for intensity monitoring */ 
void addBeamSegment(double dist) {
	beam_sum[nMonitors] = 0.0;
	beam_z[nMonitors] = dist;
	nMonitors ++;
} 

/* Print counting statistics */
void printStat() {
   double eff[MAXCOMP], effRel[MAXCOMP]; // efficiencies absolute and relative
   double sum, sumPre;
   int i;
   long cnt;
   FILE *hfile;
   sum = srccount;
   sumPre = sum;
   for (i=0;i<nComponents;i++) {
      cnt = stats[i].cnt;
         if  (cnt>0) {
         eff[i] = cnt/sum;
         effRel[i] = cnt/sumPre;
         sumPre = cnt;
      }
   }
   hfile=fopen("statistics.txt","w");
   printf("Counting statistics [ID, sum, counts, eff_rel, eff]:\n");
   if (hfile) fprintf(hfile, "Counting statistics [ID, sum, counts, eff_rel, eff]:\n");
   for (i=0;i<nComponents;i++) {
      if  (stats[i].cnt>0) {
         printf("[%d] %s:\t%g\t%ld\t%g\t%g\n",stats[i].idx ,stats[i].id, stats[i].sum, stats[i].cnt, effRel[i], eff[i]);
         if (hfile) fprintf(hfile, "%s:\t%g\t%ld\t%g\t%g\n",stats[i].id, stats[i].sum, stats[i].cnt, effRel[i], eff[i]);
      }
   }
   if (hfile) fclose(hfile);
   hfile=fopen("intensity.txt","w");
   if (hfile) {
	   fprintf(hfile, "Counting statistics [distance, intensity]:\n");
       for (i=0;i<nMonitors;i++) {
         if (hfile) fprintf(hfile, "%g\t%g\n",beam_z[i], beam_sum[i]);
       }
       fclose(hfile);
   }
}

